---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Contact Support & Feedback | 3DPrintingCostCalc.com"
  description="Contact the team behind 3DPrintingCostCalc.com. Submit printer preset suggestions, spool tare weight additions, or report calculation issues."
  breadcrumbs={[
    { name: 'Home', item: 'https://3dprintingcostcalc.com/' },
    { name: 'Contact Us', item: 'https://3dprintingcostcalc.com/contact/' }
  ]}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8 text-slate-300">
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Contact & Support</h1>
      <p class="text-xs text-slate-500 font-mono">We welcome community feedback, tare weight submissions, and printer presets.</p>
    </div>

    <div class="p-6 rounded-2xl bg-[#0e1628] border border-white/10 space-y-4 text-xs sm:text-sm">
      <h2 class="text-lg font-bold text-white">Get in Touch</h2>
      <p class="leading-relaxed">
        Have a question about our 3D print calculations, want to request support for a new 3D printer model, or submit an empty spool tare weight to our database?
      </p>

      <div class="p-4 rounded-xl bg-[#162035] border border-white/5 space-y-2">
        <span class="text-xs text-slate-400 block">Official Support Email:</span>
        <a href="mailto:support@3dprintingcostcalc.com" class="text-lg font-mono font-bold text-cyan-400 hover:underline">
          support@3dprintingcostcalc.com
        </a>
        <p class="text-[11px] text-slate-400 pt-1">
          Response turnaround time: Typically within 24 to 48 hours on business days.
        </p>
      </div>

      <div class="space-y-2 pt-2">
        <h3 class="font-bold text-white">Suggesting a Tare Weight or Machine Preset?</h3>
        <p class="text-xs text-slate-400 leading-relaxed">
          When submitting new hardware data, please include the manufacturer brand, exact model name, empty weight in grams weighed on a digital scale, and spool material type (cardboard, reusable plastic, or composite).
        </p>
      </div>
    </div>
  </div>
</Layout>
