---
import Layout from '../../layouts/Layout.astro';
import PrintCostCalculator from '../../components/PrintCostCalculator.astro';
import materials from '../../data/materials.json';

export async function getStaticPaths() {
  return materials.map((material) => ({
    params: { materialSlug: material.slug },
    props: { material },
  }));
}

const { material } = Astro.props;

const costPerGram = material.defaultPricePerKgUsd / 1000;
const bulkCostPerGram = material.bulkDealPriceUsd / 1000;

const faqs = [
  {
    question: `How much does 1 gram of ${material.name} cost?`,
    answer: `At an average retail price of $${material.defaultPricePerKgUsd.toFixed(2)} per 1 kg spool, ${material.name} costs $${costPerGram.toFixed(4)} per gram (approximately ${(costPerGram * 100).toFixed(2)} cents per gram). In bulk purchase deals (${material.bulkDealBrand}), prices drop to roughly $${bulkCostPerGram.toFixed(4)} per gram ($${material.bulkDealPriceUsd.toFixed(2)}/kg).`
  },
  {
    question: `What is the density of ${material.name} and how does it affect length?`,
    answer: `${material.name} has a density of ${material.densityGcm3} g/cm³. Because filament is sold by weight (1 kg) but printed by volume, ${material.densityGcm3 < 1.2 ? 'lower density means you get MORE length and volume per spool compared to standard PLA.' : 'density directly dictates the meters per spool: 1 kg yields approximately ' + material.metersPerKg175 + ' meters of 1.75mm filament.'}`
  },
  {
    question: `What are the recommended printing temperatures for ${material.name}?`,
    answer: `Optimal extruder printing temperature for ${material.name} is ${material.nozzleTempC}°C with a heated bed temperature of ${material.bedTempC}°C. ${material.heatDeflectionC > 70 ? 'Because of high thermal deflection, an enclosure or draft shield is recommended to prevent corner warping.' : ''}`
  }
];
---

<Layout
  title={`${material.name} Cost Per Gram, Density & Slicing Guide | 3DPrintingCostCalc.com`}
  description={`Calculate 3D print costs with ${material.name}. Features ${material.densityGcm3} g/cm³ density, $${costPerGram.toFixed(4)}/g unit cost, meters per spool, and optimal extrusion temperatures.`}
  keywords={`${material.shortName.toLowerCase()} cost per gram, ${material.shortName.toLowerCase()} filament cost calculator, ${material.shortName.toLowerCase()} density 3d printing, ${material.name.toLowerCase()} cost`}
  faqList={faqs}
  breadcrumbs={[
    { name: 'Home', item: 'https://3dprintingcostcalc.com/' },
    { name: 'Materials', item: 'https://3dprintingcostcalc.com/filament-cost-calculator/' },
    { name: material.name, item: `https://3dprintingcostcalc.com/filament-cost/${material.slug}/` }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-950/60 text-emerald-300 border border-emerald-800/40">
        Material Engineering Profile · {material.category}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        {material.name} <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Cost & Density</span> Guide
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {material.description}
      </p>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-mono">
      <div class="p-4 rounded-2xl bg-[#0e1628] border border-white/10">
        <span class="text-slate-400 block mb-1">Density:</span>
        <span class="text-2xl font-bold text-white">{material.densityGcm3} g/cm³</span>
      </div>
      <div class="p-4 rounded-2xl bg-[#0e1628] border border-white/10">
        <span class="text-slate-400 block mb-1">Unit Cost:</span>
        <span class="text-2xl font-bold text-emerald-400">${costPerGram.toFixed(4)}/g</span>
      </div>
      <div class="p-4 rounded-2xl bg-[#0e1628] border border-white/10">
        <span class="text-slate-400 block mb-1">1.75mm Spool Length:</span>
        <span class="text-2xl font-bold text-cyan-400">{material.metersPerKg175 > 0 ? `${material.metersPerKg175} m` : 'N/A (Resin)'}</span>
      </div>
      <div class="p-4 rounded-2xl bg-[#0e1628] border border-white/10">
        <span class="text-slate-400 block mb-1">Heat Deflection:</span>
        <span class="text-2xl font-bold text-amber-400">{material.heatDeflectionC}°C</span>
      </div>
    </div>

    <!-- Live Interactive Calculator Pre-loaded with this material -->
    <div class="pt-6">
      <PrintCostCalculator initialMaterialSlug={material.slug} titleOverride={`Live Calculator Pre-configured for ${material.name}`} />
    </div>

    <!-- Thermal & Mechanical Specifications -->
    <div class="p-6 rounded-2xl bg-[#0e1628] border border-white/10 space-y-4">
      <h2 class="text-xl font-bold text-white">Printing Temperatures & Engineering Specs</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
        <div class="p-4 rounded-xl bg-[#162035] border border-white/5">
          <span class="text-slate-400 block mb-1">Extruder Nozzle Temp:</span>
          <span class="text-lg font-bold text-white">{material.nozzleTempC > 0 ? `${material.nozzleTempC}°C` : 'Room Temp (UV 405nm)'}</span>
        </div>
        <div class="p-4 rounded-xl bg-[#162035] border border-white/5">
          <span class="text-slate-400 block mb-1">Heated Bed Temp:</span>
          <span class="text-lg font-bold text-white">{material.bedTempC > 0 ? `${material.bedTempC}°C` : 'None required'}</span>
        </div>
        <div class="p-4 rounded-xl bg-[#162035] border border-white/5">
          <span class="text-slate-400 block mb-1">Tensile Strength:</span>
          <span class="text-lg font-bold text-cyan-400">{material.tensileMpa} MPa</span>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">{material.name} Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-[#0e1628] border border-white/10 transition-all hover:border-emerald-500/30">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-white text-sm sm:text-base gap-4">
              <span class="flex items-center gap-3">
                <span class="text-emerald-400 font-mono text-xs px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/40 shrink-0">Q{index + 1}</span>
                <span class="text-slate-100 group-hover:text-emerald-300 transition-colors">{faq.question}</span>
              </span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-white/5 text-xs sm:text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>
