---
import MaterialProfileContent from '../../components/pages/MaterialProfileContent.astro';
import materials from '../../data/materials.json';

export async function getStaticPaths() {
  return materials.map((material) => ({
    params: { materialSlug: material.slug },
    props: { material },
  }));
}

const { material } = Astro.props;
---
<MaterialProfileContent material={material} locale="en" />
