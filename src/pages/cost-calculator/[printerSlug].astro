---
import PrinterProfileContent from '../../components/pages/PrinterProfileContent.astro';
import printers from '../../data/printers.json';

export async function getStaticPaths() {
  return printers.map((printer) => ({
    params: { printerSlug: printer.slug },
    props: { printer },
  }));
}

const { printer } = Astro.props;
---
<PrinterProfileContent printer={printer} locale="en" />
