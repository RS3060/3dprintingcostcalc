---
import Layout from '../../layouts/Layout.astro';
import materials from '../../data/materials.json';

const faqs = [
  {
    question: "How do you calculate the length of filament on a 1kg spool?",
    answer: "Filament length is calculated from mass, polymer density, and cross-sectional wire area: Length = Mass ÷ (Density × π × Radius²). For standard 1.75mm PLA with a density of 1.24 g/cm³ (radius = 0.875mm = 0.0875cm), the cross-sectional area is π × (0.0875)² ≈ 0.02405 cm². A 1,000g spool has a total volume of 1,000 ÷ 1.24 ≈ 806.45 cm³. Dividing volume by cross-sectional area yields 806.45 ÷ 0.02405 ≈ 33,528 cm, or approximately 335.3 meters (1,100 feet)."
  },
  {
    question: "Why does 2.85mm filament have fewer meters per spool than 1.75mm?",
    answer: "Because cross-sectional area scales with the square of the diameter (A = π × r²), a 2.85mm filament has an area of 6.379 mm², which is roughly 2.65 times thicker than a 1.75mm filament (2.405 mm²). Consequently, 1 kg of 2.85mm PLA filament yields only about 125 meters of length, compared to 335 meters for 1.75mm filament. However, because each millimeter contains 2.65x more volume, the print volume delivered per gram remains identical."
  },
  {
    question: "How do I calculate cost per meter of 3D printer filament?",
    answer: "To find cost per meter, divide your spool purchase price by total meters on the spool: Cost Per Meter = Spool Price ÷ Total Spool Meters. On a $20.00 1kg spool of 1.75mm PLA containing 335 meters, the cost is $20.00 ÷ 335m = $0.0597 per meter (approx 5.97 cents per meter, or 1.82 cents per foot)."
  }
];
---

<Layout
  title="Filament Cost & Length Calculator (Weight to Length) | 3DPrintingCostCalc.com"
  description="Convert filament weight to length, calculate cost per gram and cost per meter for 1.75mm and 2.85mm PLA, PETG, ABS, TPU, and Nylon spools."
  keywords="filament cost calculator, filament length to weight calculator, cost per gram of filament, 1kg filament length, filament calculator, 3d printer filament cost calculator"
  faqList={faqs}
  breadcrumbs={[
    { name: 'Home', item: 'https://3dprintingcostcalc.com/' },
    { name: 'Filament Cost & Length', item: 'https://3dprintingcostcalc.com/filament-cost-calculator/' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-950/60 text-emerald-300 border border-emerald-800/40">
        Volumetric Physics Converter
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Filament <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Cost & Length</span> Calculator
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Convert between spool price, weight in grams, length in meters/feet, and volume in cm³. Calculate exact cost per gram and cost per meter across 1.75mm and 2.85mm diameters for PLA, PETG, ABS, TPU, and Carbon Fiber.
      </p>
    </div>

    <!-- Converter Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Input Controls (6 Cols) -->
      <div class="lg:col-span-6 bg-[#0e1628] border border-white/10 rounded-2xl p-6 shadow-xl space-y-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-emerald-400 font-mono">
          Spool & Material Configuration
        </h2>

        <div class="space-y-4 text-xs">
          <!-- Material Selector -->
          <div>
            <label for="fMatSelect" class="block font-medium text-slate-300 mb-1">Polymer / Filament Type:</label>
            <select id="fMatSelect" class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-sm text-white">
              <option value="custom">➕ Custom Material (Manual Entry)</option>
              {materials.filter(m => m.diameterMm > 0).map((m) => (
                <option value={m.slug} data-density={m.densityGcm3} data-price={m.defaultPricePerKgUsd}>
                  {m.name} ({m.densityGcm3} g/cm³)
                </option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <!-- Diameter -->
            <div>
              <label for="fDiameterSelect" class="block font-medium text-slate-300 mb-1">Filament Diameter:</label>
              <select id="fDiameterSelect" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono">
                <option value="1.75" selected>1.75 mm (Standard)</option>
                <option value="2.85">2.85 mm (UltiMaker / Large)</option>
              </select>
            </div>

            <!-- Material Density Override -->
            <div>
              <label for="fDensityInput" class="block font-medium text-slate-300 mb-1">Density (g/cm³):</label>
              <input type="number" id="fDensityInput" step="0.01" value="1.24" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>

            <!-- Spool Net Weight -->
            <div>
              <label for="fSpoolWeight" class="block font-medium text-slate-300 mb-1">Spool Weight (grams):</label>
              <input type="number" id="fSpoolWeight" step="50" value="1000" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>

            <!-- Spool Price -->
            <div>
              <label for="fSpoolPrice" class="block font-medium text-slate-300 mb-1">Spool Purchase Price ($):</label>
              <input type="number" id="fSpoolPrice" step="0.5" value="19.99" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>
          </div>

          <!-- Quick interactive Weight to Length Converter tool -->
          <div class="pt-4 border-t border-white/5 space-y-3">
            <h3 class="font-bold text-white text-sm">Weight ⇄ Length Live Converter</h3>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="fGramsToConvert" class="block text-slate-400 mb-1">Enter Grams (g):</label>
                <input type="number" id="fGramsToConvert" value="85" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-white font-mono text-sm" />
              </div>
              <div>
                <label class="block text-slate-400 mb-1">Equivalent Length:</label>
                <div class="bg-[#162035] border border-white/5 rounded-xl px-3 py-2 text-cyan-400 font-mono text-sm font-bold" id="fMetersResult">
                  28.5 meters
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Output Metrics Card (6 Cols) -->
      <div class="lg:col-span-6 bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-emerald-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-emerald-300 font-semibold">Unit Cost Metrics</span>
          <div class="grid grid-cols-2 gap-4 mt-3">
            <div class="p-4 rounded-xl bg-black/30 border border-white/5">
              <span class="text-xs text-slate-400 block mb-1">Cost Per Gram</span>
              <span class="text-2xl sm:text-3xl font-black text-white font-mono" id="fCostGram">$0.0200</span>
              <span class="text-[11px] text-slate-500 block font-mono mt-1">2.00¢ per gram</span>
            </div>
            <div class="p-4 rounded-xl bg-black/30 border border-white/5">
              <span class="text-xs text-slate-400 block mb-1">Cost Per Meter</span>
              <span class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono" id="fCostMeter">$0.0596</span>
              <span class="text-[11px] text-slate-500 block font-mono mt-1" id="fCostFoot">1.82¢ per foot</span>
            </div>
          </div>
        </div>

        <div class="border-t border-white/10 pt-4 space-y-3 font-mono text-xs">
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">Total Length on Spool:</span>
            <span id="fTotalMeters" class="font-bold text-white">335.3 meters (1,100 ft)</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">Total Extruded Volume:</span>
            <span id="fTotalVolume" class="font-bold text-white">806.5 cm³</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">Cost for 100g Print:</span>
            <span id="f100gCost" class="font-bold text-cyan-400">$2.00</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">Cost for 10 meters:</span>
            <span id="f10mCost" class="font-bold text-cyan-400">$0.60</span>
          </div>
        </div>

        <!-- Formula Callout -->
        <div class="p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/20 text-xs text-slate-300 space-y-1">
          <span class="font-bold text-emerald-300 block">Density Physics Principle:</span>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            Lightweight polymers like ABS (1.04 g/cm³) give you <strong>19% more meters</strong> of filament per 1kg spool compared to PLA (1.24 g/cm³), and <strong>27% more</strong> than dense Matte PLA (1.32 g/cm³).
          </p>
        </div>
      </div>
    </div>

    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">Filament Weight to Length FAQ</h2>
      <div class="space-y-3">
        {faqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-[#0e1628] border border-white/10 transition-all hover:border-emerald-500/30">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-white text-sm sm:text-base gap-4">
              <span class="flex items-center gap-3">
                <span class="text-emerald-400 font-mono text-xs px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/40 shrink-0">Q{index + 1}</span>
                <span class="text-slate-100 group-hover:text-emerald-300 transition-colors">{faq.question}</span>
              </span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-white/5 text-xs sm:text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import materials from '../../data/materials.json';

  const matSelect = document.getElementById('fMatSelect') as HTMLSelectElement;
  const diameterSelect = document.getElementById('fDiameterSelect') as HTMLSelectElement;
  const densityInput = document.getElementById('fDensityInput') as HTMLInputElement;
  const spoolWeightInput = document.getElementById('fSpoolWeight') as HTMLInputElement;
  const spoolPriceInput = document.getElementById('fSpoolPrice') as HTMLInputElement;
  const gramsToConvertInput = document.getElementById('fGramsToConvert') as HTMLInputElement;

  const fCostGram = document.getElementById('fCostGram');
  const fCostMeter = document.getElementById('fCostMeter');
  const fCostFoot = document.getElementById('fCostFoot');
  const fTotalMeters = document.getElementById('fTotalMeters');
  const fTotalVolume = document.getElementById('fTotalVolume');
  const f100gCost = document.getElementById('f100gCost');
  const f10mCost = document.getElementById('f10mCost');
  const fMetersResult = document.getElementById('fMetersResult');

  function calculateFilament() {
    const density = parseFloat(densityInput.value) || 1.24;
    const diameter = parseFloat(diameterSelect.value) || 1.75;
    const spoolWeight = parseFloat(spoolWeightInput.value) || 1000;
    const spoolPrice = parseFloat(spoolPriceInput.value) || 20;
    const gramsConvert = parseFloat(gramsToConvertInput.value) || 0;

    // Radius in cm: (diameter / 2) / 10
    const radiusCm = (diameter / 2) / 10;
    const crossSectionAreaCm2 = Math.PI * radiusCm * radiusCm;

    // Total Volume in cm³ = Mass / Density
    const totalVolumeCm3 = spoolWeight / density;

    // Total Length in cm = Volume / Cross-sectional Area
    const totalLengthCm = totalVolumeCm3 / crossSectionAreaCm2;
    const totalLengthM = totalLengthCm / 100;
    const totalLengthFt = totalLengthM * 3.28084;

    const costPerGram = spoolPrice / spoolWeight;
    const costPerMeter = totalLengthM > 0 ? spoolPrice / totalLengthM : 0;
    const costPerFoot = costPerMeter / 3.28084;

    // Live grams to meters:
    const convertVolumeCm3 = gramsConvert / density;
    const convertLengthM = (convertVolumeCm3 / crossSectionAreaCm2) / 100;

    if (fCostGram) fCostGram.textContent = `$${costPerGram.toFixed(4)}`;
    if (fCostMeter) fCostMeter.textContent = `$${costPerMeter.toFixed(4)}`;
    if (fCostFoot) fCostFoot.textContent = `${(costPerFoot * 100).toFixed(2)}¢ per foot`;
    if (fTotalMeters) fTotalMeters.textContent = `${totalLengthM.toFixed(1)} meters (${Math.round(totalLengthFt)} ft)`;
    if (fTotalVolume) fTotalVolume.textContent = `${totalVolumeCm3.toFixed(1)} cm³`;
    if (f100gCost) f100gCost.textContent = `$${(costPerGram * 100).toFixed(2)}`;
    if (f10mCost) f10mCost.textContent = `$${(costPerMeter * 10).toFixed(2)}`;
    if (fMetersResult) fMetersResult.textContent = `${convertLengthM.toFixed(1)} meters (${(convertLengthM * 3.28084).toFixed(1)} ft)`;
  }

  matSelect?.addEventListener('change', () => {
    if (matSelect.value === 'custom') {
      calculateFilament();
      return;
    }
    const selected = materials.find(m => m.slug === matSelect.value);
    if (selected) {
      densityInput.value = selected.densityGcm3.toString();
      spoolPriceInput.value = selected.defaultPricePerKgUsd.toString();
      calculateFilament();
    }
  });

  const onManualMaterialParam = () => {
    const selected = materials.find(m => m.slug === matSelect.value);
    if (selected) {
      if (
        parseFloat(densityInput.value) !== selected.densityGcm3 ||
        parseFloat(spoolPriceInput.value) !== selected.defaultPricePerKgUsd
      ) {
        matSelect.value = 'custom';
      }
    }
    calculateFilament();
  };

  densityInput?.addEventListener('input', onManualMaterialParam);
  spoolPriceInput?.addEventListener('input', onManualMaterialParam);

  [diameterSelect, spoolWeightInput, gramsToConvertInput].forEach(inp => {
    inp?.addEventListener('input', calculateFilament);
    inp?.addEventListener('change', calculateFilament);
  });

  calculateFilament();
</script>
