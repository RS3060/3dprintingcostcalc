---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  {
    question: "Why does multi-color 3D printing produce so much purge waste ('poop')?",
    answer: "Single-nozzle multi-material systems (like the Bambu Lab AMS, Creality CFS, or Anycubic ACE) use a single hotend to extrude multiple filament colors. When switching from one color to another (especially from dark black to light white), the printer must cut the filament, retract it, load the new color, and flush out all residual melted plastic through the purge chute so colors do not bleed. A print with 500 color changes can easily flush 150g to 300g of purge waste."
  },
  {
    question: "How does printing multiple copies in a batch reduce AMS waste?",
    answer: "Color changes occur per layer, not per object. If you print one figurine that requires 200 color swaps, the printer purges 200 times. If you print 10 identical figurines on the same build plate, the printer still only purges 200 times! The total purge waste remains identical, but is now divided evenly across all 10 items. This reduces the purge waste per item by 90% (from 80g of waste per unit down to just 8g per unit)."
  },
  {
    question: "How can I reduce Bambu Lab AMS flush waste in slicer settings?",
    answer: "In Bambu Studio or OrcaSlicer, enable 'Flush into this object's infill' and 'Flush into this object's support'. This dumps transitional colors into internal gyroid infill where it remains invisible. Additionally, recalibrate your Flushing Volumes matrix: changing from white to black requires only 120mm³ of flush, whereas changing from black to white requires 350mm³–400mm³. Never keep default 1.0 flush multipliers across every transition."
  }
];
---

<Layout
  title="Bambu Lab AMS Purge Waste & Multi-Color Batch Calculator | 3DPrintingCostCalc.com"
  description="Calculate Bambu AMS and multi-color purge poop waste. See how batch printing on a single plate divides flush waste by 10x and dramatically cuts per-unit 3D printing cost."
  keywords="bambu ams waste calculator, multicolor 3d print cost calculator, purge volume calculator, bambu poop calculator, 3d print batch optimizer"
  faqList={faqs}
  breadcrumbs={[
    { name: 'Home', item: 'https://3dprintingcostcalc.com/' },
    { name: 'AMS Purge Waste Calculator', item: 'https://3dprintingcostcalc.com/multicolor-ams-waste-calculator/' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-violet-950/60 text-violet-300 border border-violet-800/40">
        Multi-Material Batch Economics
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Bambu AMS & Multi-Color <span class="bg-gradient-to-r from-violet-400 via-pink-400 to-cyan-400 bg-clip-text text-transparent">Purge Waste</span> Calculator
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Calculate the exact filament grams and dollars lost to purge chute poop and prime towers. Visualize how full-plate batch printing divides flush waste across multiple units to maximize your Etsy margins.
      </p>
    </div>

    <!-- Interactive Calculator -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Input Controls (6 Cols) -->
      <div class="lg:col-span-6 bg-[#0e1628] border border-white/10 rounded-2xl p-6 shadow-xl space-y-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-violet-400 font-mono">
          Multi-Color Job Parameters
        </h2>

        <div class="space-y-4 text-xs">
          <div class="grid grid-cols-2 gap-4">
            <!-- Filament Swaps -->
            <div>
              <label for="amsSwapsInput" class="block font-medium text-slate-300 mb-1">Total Filament Swaps:</label>
              <input type="number" id="amsSwapsInput" value="280" step="10" min="1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
              <span class="text-[11px] text-slate-400 block mt-1">Total color changes in job</span>
            </div>

            <!-- Flush Per Swap -->
            <div>
              <label for="amsFlushPerSwap" class="block font-medium text-slate-300 mb-1">Avg Flush Per Swap (g):</label>
              <input type="number" id="amsFlushPerSwap" value="0.38" step="0.02" min="0.1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
              <span class="text-[11px] text-slate-400 block mt-1">Default ~0.35g to 0.45g</span>
            </div>

            <!-- Prime Tower Weight -->
            <div>
              <label for="amsPrimeTower" class="block font-medium text-slate-300 mb-1">Prime Tower Weight (g):</label>
              <input type="number" id="amsPrimeTower" value="30" step="5" min="0" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
              <span class="text-[11px] text-slate-400 block mt-1">Wipe tower on build plate</span>
            </div>

            <!-- Model Weight Per Unit -->
            <div>
              <label for="amsModelWeight" class="block font-medium text-slate-300 mb-1">Single Model Weight (g):</label>
              <input type="number" id="amsModelWeight" value="50" step="5" min="1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
              <span class="text-[11px] text-slate-400 block mt-1">Pure model plastic</span>
            </div>

            <!-- Spool Price -->
            <div>
              <label for="amsFilamentPrice" class="block font-medium text-slate-300 mb-1">Average Spool Cost ($/kg):</label>
              <input type="number" id="amsFilamentPrice" value="22" step="1" min="1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>

            <!-- Batch Count -->
            <div>
              <label for="amsBatchCount" class="block font-medium text-slate-300 mb-1">Copies Printed on Plate:</label>
              <input type="number" id="amsBatchCount" value="6" step="1" min="1" max="30" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
              <span class="text-[11px] text-slate-400 block mt-1">Batch scale on 256mm plate</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Result Card (6 Cols) -->
      <div class="lg:col-span-6 bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-violet-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-violet-300 font-semibold">Plate Purge Waste Impact</span>
          <div class="flex items-baseline gap-2 mt-2">
            <span class="text-4xl sm:text-5xl font-black text-white font-mono" id="amsTotalWasteGrams">136.4g</span>
            <span class="text-sm text-slate-400">Total Waste on Plate</span>
          </div>
          <span class="text-xs text-slate-400 block font-mono mt-1" id="amsWasteCostDisplay">
            $3.00 of filament discarded into poop chute & tower
          </span>
        </div>

        <!-- Single vs Batch Comparison Box -->
        <div class="grid grid-cols-2 gap-3 text-xs font-mono">
          <div class="p-4 rounded-xl bg-red-950/40 border border-red-500/20 space-y-1">
            <span class="text-red-400 font-bold block">1 Single Item Printed:</span>
            <div class="text-lg font-bold text-white" id="amsSingleUnitWaste">136.4g Waste</div>
            <span class="text-[11px] text-red-300 block" id="amsSingleUnitCost">+$3.00 waste/unit</span>
            <span class="text-[10px] text-slate-400 block">73% waste ratio</span>
          </div>

          <div class="p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/20 space-y-1">
            <span class="text-emerald-400 font-bold block" id="amsBatchTitle">6 Items Batch:</span>
            <div class="text-lg font-bold text-white" id="amsBatchUnitWaste">22.7g Waste</div>
            <span class="text-[11px] text-emerald-300 block" id="amsBatchUnitCost">+$0.50 waste/unit</span>
            <span class="text-[10px] text-emerald-400 block">83% waste reduction</span>
          </div>
        </div>

        <!-- Plate Batch Curve Visualization -->
        <div class="space-y-2">
          <div class="flex justify-between text-xs font-mono text-slate-300">
            <span>Per-Unit Purge Waste Curve:</span>
            <span class="text-cyan-400" id="amsSavingsBadge">Saves $2.50 per unit in a batch</span>
          </div>
          <div class="p-4 rounded-xl bg-black/40 border border-white/5 space-y-2 text-xs font-mono">
            <div class="flex justify-between text-[11px] text-slate-400">
              <span>Qty 1: 136g waste ($3.00)</span>
              <span>Qty 4: 34g waste ($0.75)</span>
              <span>Qty 10: 14g waste ($0.30)</span>
            </div>
            <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
              <div id="batchEfficiencyBar" class="h-full bg-gradient-to-r from-violet-500 to-cyan-400" style="width: 83%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">Multi-Color & AMS Purge Waste FAQ</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {faqs.map((faq) => (
          <div class="p-5 rounded-2xl bg-[#0e1628] border border-white/10 space-y-2">
            <h3 class="text-sm font-bold text-white">{faq.question}</h3>
            <p class="text-xs text-slate-300 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  const swapsInput = document.getElementById('amsSwapsInput') as HTMLInputElement;
  const flushInput = document.getElementById('amsFlushPerSwap') as HTMLInputElement;
  const towerInput = document.getElementById('amsPrimeTower') as HTMLInputElement;
  const modelInput = document.getElementById('amsModelWeight') as HTMLInputElement;
  const priceInput = document.getElementById('amsFilamentPrice') as HTMLInputElement;
  const batchInput = document.getElementById('amsBatchCount') as HTMLInputElement;

  const totalWasteDisplay = document.getElementById('amsTotalWasteGrams');
  const wasteCostDisplay = document.getElementById('amsWasteCostDisplay');
  const singleUnitWaste = document.getElementById('amsSingleUnitWaste');
  const singleUnitCost = document.getElementById('amsSingleUnitCost');
  const batchTitle = document.getElementById('amsBatchTitle');
  const batchUnitWaste = document.getElementById('amsBatchUnitWaste');
  const batchUnitCost = document.getElementById('amsBatchUnitCost');
  const savingsBadge = document.getElementById('amsSavingsBadge');
  const efficiencyBar = document.getElementById('batchEfficiencyBar');

  function calculateAMS() {
    const swaps = parseFloat(swapsInput.value) || 0;
    const flush = parseFloat(flushInput.value) || 0;
    const tower = parseFloat(towerInput.value) || 0;
    const model = parseFloat(modelInput.value) || 0;
    const priceKg = parseFloat(priceInput.value) || 20;
    const batch = Math.max(1, parseInt(batchInput.value, 10) || 1);

    const pricePerGram = priceKg / 1000;

    // Total plate waste grams = (swaps * flush) + prime tower
    const totalPlateWaste = (swaps * flush) + tower;
    const totalWasteCost = totalPlateWaste * pricePerGram;

    const singleWastePerUnit = totalPlateWaste;
    const singleCostPerUnit = totalWasteCost;

    const batchWastePerUnit = totalPlateWaste / batch;
    const batchCostPerUnit = totalWasteCost / batch;

    const savedPerUnit = Math.max(0, singleCostPerUnit - batchCostPerUnit);
    const reductionPct = singleCostPerUnit > 0 ? ((savedPerUnit / singleCostPerUnit) * 100) : 0;

    if (totalWasteDisplay) totalWasteDisplay.textContent = `${totalPlateWaste.toFixed(1)}g`;
    if (wasteCostDisplay) wasteCostDisplay.textContent = `$${totalWasteCost.toFixed(2)} discarded into purge chute & tower`;

    if (singleUnitWaste) singleUnitWaste.textContent = `${singleWastePerUnit.toFixed(1)}g Waste`;
    if (singleUnitCost) singleUnitCost.textContent = `+$${singleCostPerUnit.toFixed(2)} waste/unit`;

    if (batchTitle) batchTitle.textContent = `${batch} Items Batch:`;
    if (batchUnitWaste) batchUnitWaste.textContent = `${batchWastePerUnit.toFixed(1)}g Waste`;
    if (batchUnitCost) batchUnitCost.textContent = `+$${batchCostPerUnit.toFixed(2)} waste/unit`;

    if (savingsBadge) savingsBadge.textContent = `Saves $${savedPerUnit.toFixed(2)} per unit in batch (${reductionPct.toFixed(0)}% cut)`;
    if (efficiencyBar) efficiencyBar.style.width = `${Math.min(100, Math.max(10, reductionPct))}%`;
  }

  [swapsInput, flushInput, towerInput, modelInput, priceInput, batchInput].forEach(inp => {
    inp?.addEventListener('input', calculateAMS);
  });

  calculateAMS();
</script>
