---
import Layout from '../../layouts/Layout.astro';
import tareData from '../../data/spoolTareWeights.json';

const faqs = [
  {
    question: "What is empty spool tare weight?",
    answer: "Tare weight is the weight of the empty plastic, cardboard, or reusable spool itself without any filament on it. Because partially used spools cannot be unwound without tangling, makers place the entire spool on a kitchen scale to measure its gross weight. Subtracting the known tare weight from the scale reading reveals the exact remaining net filament in grams: Net Filament = Gross Scale Weight - Empty Spool Tare Weight."
  },
  {
    question: "How much does an empty Bambu Lab spool weigh?",
    answer: "The standard Bambu Lab reusable 2-piece injection-molded plastic spool weighs approximately 212 grams (with some high-temperature polycarbonate versions weighing 248g). If you are using a Bambu refill where the cardboard core is placed inside the reusable spool, the internal cardboard core alone weighs approximately 37 grams."
  },
  {
    question: "How much does a Polymaker cardboard spool weigh?",
    answer: "A standard 1 kg Polymaker cardboard spool weighs approximately 140 grams (±10g). Cardboard spools absorb minor atmospheric humidity, so very humid environments can cause cardboard tare weights to increase by 5 to 10 grams."
  },
  {
    question: "How do I avoid running out of filament mid-print?",
    answer: "Before starting an overnight or multi-hour print, weigh your spool on a digital kitchen scale (accurate to 1g). Select your spool brand from our Tare Weight Database, find the net filament remaining, and compare it with the required filament grams indicated in your slicer. If the remaining net grams exceed your slicer requirement by at least 15 grams (buffer for purge lines and sensor distance), it is safe to print."
  }
];
---

<Layout
  title="Empty Spool Tare Weight Database & Remaining Filament Calculator | 3DPrintingCostCalc.com"
  description="Weigh your spool on a kitchen scale to see how much filament is left. Search 40+ empty spool tare weights for Bambu Lab, Polymaker, eSUN, Sunlu, Elegoo, and Prusament."
  keywords="how much filament left on spool, empty spool weight database, bambu spool weight, polymaker empty spool weight, filament spool tare weight"
  faqList={faqs}
  breadcrumbs={[
    { name: 'Home', item: 'https://3dprintingcostcalc.com/' },
    { name: 'Spool Tare Calculator', item: 'https://3dprintingcostcalc.com/spool-remaining-calculator/' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-950/60 text-cyan-300 border border-cyan-800/40">
        Scale-to-Net Tare Database
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Remaining Filament & <span class="bg-gradient-to-r from-cyan-400 to-emerald-400 bg-clip-text text-transparent">Spool Tare Weight</span> Lookup
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Put your partially used spool on a digital scale. Select your filament brand to subtract empty spool tare weight and verify whether your print will succeed overnight or run out mid-job.
      </p>
    </div>

    <!-- Interactive Calculator -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Input Controls (6 Cols) -->
      <div class="lg:col-span-6 bg-[#0e1628] border border-white/10 rounded-2xl p-6 shadow-xl space-y-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-400 font-mono">
          Weigh Your Partial Spool
        </h2>

        <div class="space-y-4 text-xs">
          <!-- Spool Brand & Model Selector -->
          <div>
            <label for="spoolBrandSelect" class="block font-medium text-slate-300 mb-1">
              Select Empty Spool Profile:
            </label>
            <select id="spoolBrandSelect" class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-sm text-white font-medium">
              <option value="custom">➕ Custom Spool (Manual Tare Entry)</option>
              {tareData.map((s) => (
                <option value={s.id} data-tare={s.emptyWeightGrams}>
                  {s.brand} - {s.spoolType} ({s.emptyWeightGrams}g tare)
                </option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <!-- Gross Scale Weight -->
            <div>
              <label for="grossScaleInput" class="block font-medium text-slate-300 mb-1">
                Scale Gross Reading (grams):
              </label>
              <input
                type="number"
                id="grossScaleInput"
                step="1"
                min="0"
                value="410"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono"
              />
              <span class="text-[11px] text-slate-400 block mt-1">Spool + remaining plastic</span>
            </div>

            <!-- Empty Tare Weight -->
            <div>
              <label for="tareWeightInput" class="block font-medium text-slate-300 mb-1">
                Empty Spool Tare (grams):
              </label>
              <input
                type="number"
                id="tareWeightInput"
                step="1"
                min="0"
                value="212"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono"
              />
              <span class="text-[11px] text-slate-400 block mt-1">Auto-filled from database</span>
            </div>
          </div>

          <!-- Upcoming Print Grams -->
          <div class="pt-2">
            <label for="requiredPrintInput" class="block font-medium text-slate-300 mb-1">
              Upcoming Print Filament Needed (grams):
            </label>
            <input
              type="number"
              id="requiredPrintInput"
              step="1"
              min="0"
              value="120"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono"
            />
            <span class="text-[11px] text-slate-400 block mt-1">From your slicer preview (e.g. 120g)</span>
          </div>
        </div>
      </div>

      <!-- Result Card & Safe Badge (6 Cols) -->
      <div class="lg:col-span-6 bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-cyan-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-cyan-300 font-semibold">Net Filament Remaining</span>
          <div class="flex items-baseline gap-2 mt-2">
            <span class="text-4xl sm:text-5xl font-black text-white font-mono" id="netFilamentDisplay">198g</span>
            <span class="text-sm text-slate-400">Net Plastic</span>
          </div>
          <span class="text-xs text-slate-400 block font-mono mt-1" id="netMetersDisplay">
            ~65.8 meters (~216 ft) of 1.75mm PLA
          </span>
        </div>

        <!-- Safe to Print Badge -->
        <div id="safetyBadge" class="p-4 rounded-xl bg-emerald-950/60 border border-emerald-500/40 text-xs space-y-1.5 transition-all">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="font-bold text-emerald-300 text-sm" id="safetyTitle">Safe to Print Overnight</span>
          </div>
          <p class="text-slate-300" id="safetyDesc">
            You have 198g net filament available. Your upcoming job requires 120g, leaving a safe 78g buffer.
          </p>
        </div>

        <!-- Spool Fill Level Bar -->
        <div class="space-y-1.5">
          <div class="flex justify-between text-xs font-mono text-slate-400">
            <span>Spool Fullness:</span>
            <span id="fullnessPercentage">19.8% remaining</span>
          </div>
          <div class="h-3 w-full bg-slate-800 rounded-full overflow-hidden">
            <div id="fullnessBar" class="h-full bg-gradient-to-r from-cyan-500 to-emerald-400" style="width: 19.8%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Searchable Tare Weight Database Table -->
    <div class="space-y-4 pt-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-tight">Empty Spool Tare Weight Database</h2>
          <p class="text-slate-400 text-xs sm:text-sm">Comprehensive verified tare weights for Bambu Lab, Polymaker, eSUN, Sunlu, Elegoo, and more.</p>
        </div>
        <input
          type="text"
          id="searchTareInput"
          placeholder="Filter brand (e.g. Bambu, eSUN)..."
          class="bg-[#0e1628] border border-white/10 rounded-xl px-3 py-2 text-xs text-white font-mono w-full sm:w-64 focus:outline-none focus:ring-2 focus:ring-cyan-500"
        />
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10 bg-[#0e1628]">
        <table class="w-full text-xs text-left" id="tareTable">
          <thead class="bg-white/5 text-slate-400 font-mono border-b border-white/10">
            <tr>
              <th class="py-3 px-4">Brand</th>
              <th class="py-3 px-4">Spool Construction</th>
              <th class="py-3 px-4">Capacity</th>
              <th class="py-3 px-4 text-cyan-400 font-bold">Empty Tare Weight</th>
              <th class="py-3 px-4">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono" id="tareTableBody">
            {tareData.map((item) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-3 px-4 font-bold text-white">{item.brand}</td>
                <td class="py-3 px-4 text-slate-300 font-sans">{item.spoolType}</td>
                <td class="py-3 px-4">{item.spoolSizeKg} kg</td>
                <td class="py-3 px-4 text-cyan-400 font-bold text-sm">{item.emptyWeightGrams}g</td>
                <td class="py-3 px-4 text-slate-400 font-sans text-[11px]">{item.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">Spool Weighing & Tare Weight FAQ</h2>
      <div class="space-y-3">
        {faqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-[#0e1628] border border-white/10 transition-all hover:border-cyan-500/30">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-white text-sm sm:text-base gap-4">
              <span class="flex items-center gap-3">
                <span class="text-cyan-400 font-mono text-xs px-2 py-0.5 rounded bg-cyan-950/60 border border-cyan-800/40 shrink-0">Q{index + 1}</span>
                <span class="text-slate-100 group-hover:text-cyan-300 transition-colors">{faq.question}</span>
              </span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-white/5 text-xs sm:text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import tareData from '../../data/spoolTareWeights.json';

  const brandSelect = document.getElementById('spoolBrandSelect') as HTMLSelectElement;
  const grossInput = document.getElementById('grossScaleInput') as HTMLInputElement;
  const tareInput = document.getElementById('tareWeightInput') as HTMLInputElement;
  const reqInput = document.getElementById('requiredPrintInput') as HTMLInputElement;

  const netDisplay = document.getElementById('netFilamentDisplay');
  const metersDisplay = document.getElementById('netMetersDisplay');
  const safetyBadge = document.getElementById('safetyBadge');
  const safetyTitle = document.getElementById('safetyTitle');
  const safetyDesc = document.getElementById('safetyDesc');
  const fullnessPercentage = document.getElementById('fullnessPercentage');
  const fullnessBar = document.getElementById('fullnessBar');

  const searchInput = document.getElementById('searchTareInput') as HTMLInputElement;
  const tableBody = document.getElementById('tareTableBody');

  function calculateNet() {
    const gross = parseFloat(grossInput.value) || 0;
    const tare = parseFloat(tareInput.value) || 0;
    const req = parseFloat(reqInput.value) || 0;

    const netGrams = Math.max(0, gross - tare);

    // Meters for 1.75mm PLA (density 1.24): ~3.32 meters per 10 grams (0.332 m/g)
    const meters = netGrams * 0.3326;
    const feet = meters * 3.28084;

    const pct = Math.min(100, Math.max(0, (netGrams / 1000) * 100));

    if (netDisplay) netDisplay.textContent = `${netGrams.toFixed(0)}g`;
    if (metersDisplay) metersDisplay.textContent = `~${meters.toFixed(1)} meters (~${Math.round(feet)} ft) of 1.75mm PLA`;
    if (fullnessPercentage) fullnessPercentage.textContent = `${pct.toFixed(1)}% remaining`;
    if (fullnessBar) fullnessBar.style.width = `${pct}%`;

    // Safety badge check
    if (netGrams >= req && netGrams > 0) {
      const buffer = netGrams - req;
      safetyBadge?.classList.remove('bg-red-950/60', 'border-red-500/40');
      safetyBadge?.classList.add('bg-emerald-950/60', 'border-emerald-500/40');
      if (safetyTitle) safetyTitle.textContent = 'Safe to Print Overnight';
      if (safetyDesc) safetyDesc.textContent = `You have ${netGrams}g net filament. Your job requires ${req}g, leaving a safe ${buffer.toFixed(0)}g buffer.`;
    } else {
      const shortage = req - netGrams;
      safetyBadge?.classList.remove('bg-emerald-950/60', 'border-emerald-500/40');
      safetyBadge?.classList.add('bg-red-950/60', 'border-red-500/40');
      if (safetyTitle) safetyTitle.textContent = 'Will Run Out Mid-Print!';
      if (safetyDesc) safetyDesc.textContent = `Short by ${shortage.toFixed(0)}g! Your spool only has ${netGrams}g, but the slicer needs ${req}g. Swap spools or refill before starting.`;
    }
  }

  brandSelect?.addEventListener('change', () => {
    if (brandSelect.value === 'custom') {
      calculateNet();
      return;
    }
    const selected = tareData.find(s => s.id === brandSelect.value);
    if (selected) {
      tareInput.value = selected.emptyWeightGrams.toString();
      calculateNet();
    }
  });

  const onManualTareParam = () => {
    const selected = tareData.find(s => s.id === brandSelect.value);
    if (selected && parseFloat(tareInput.value) !== selected.emptyWeightGrams) {
      brandSelect.value = 'custom';
    }
    calculateNet();
  };

  tareInput?.addEventListener('input', onManualTareParam);

  [grossInput, reqInput].forEach(inp => {
    inp?.addEventListener('input', calculateNet);
  });

  // Table search filter
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase();
    const rows = tableBody?.querySelectorAll('tr');
    rows?.forEach((row) => {
      const text = row.textContent?.toLowerCase() || '';
      row.style.display = text.includes(q) ? '' : 'none';
    });
  });

  calculateNet();
</script>
