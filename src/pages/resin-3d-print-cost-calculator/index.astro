---
import Layout from '../../layouts/Layout.astro';
import materials from '../../data/materials.json';

const resinMaterials = materials.filter(m => m.category === 'Liquid Resin');

const faqs = [
  {
    question: "How is resin 3D printing cost calculated?",
    answer: "Resin printing costs include liquid photopolymer resin volume ($/mL), support volume (typically 15%–25% extra), Isopropyl Alcohol (IPA) wash bath degradation, disposable nitrile gloves, FEP/ACF vat release film wear, LCD mono screen amortization (lasting ~2,000 hours), and UV cure station electricity: Total Cost = Resin Cost + Wash Solvent + Consumables + Screen/FEP Wear + Post-Cure Power."
  },
  {
    question: "How much cheaper is a hollowed resin model compared to solid?",
    answer: "Hollowing a resin model with a 1.5mm to 2.0mm wall thickness reduces liquid resin consumption by 50% to 75% for medium and large models. A 150mL solid miniature print consuming $4.50 in resin drops down to approximately 40mL ($1.20 in resin) when hollowed. Remember to always include at least two drainage and vent holes to prevent trapped resin suction and eventual model cracking."
  },
  {
    question: "How much does FEP film wear cost per print?",
    answer: "A standard FEP or ACF release film costs $15 to $25 and lasts for approximately 30,000 to 50,000 layer exposures (about 30 to 50 print jobs before clouding or denting). This equals an ongoing consumable wear cost of roughly $0.40 to $0.60 per print job."
  }
];
---

<Layout
  title="Resin 3D Print Cost Calculator (SLA / MSLA) | 3DPrintingCostCalc.com"
  description="Calculate SLA/MSLA liquid photopolymer resin print costs. Accounts for resin mL, hollow savings, supports, IPA wash depletion, FEP release film wear, and LCD screen life."
  keywords="resin 3d print cost calculator, resin print price calculator, msla print cost, sla 3d printer cost"
  faqList={faqs}
  breadcrumbs={[
    { name: 'Home', item: 'https://3dprintingcostcalc.com/' },
    { name: 'Resin 3D Print Cost', item: 'https://3dprintingcostcalc.com/resin-3d-print-cost-calculator/' }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-pink-950/60 text-pink-300 border border-pink-800/40">
        Photopolymer SLA / MSLA Physics
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Resin 3D Print <span class="bg-gradient-to-r from-pink-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent">Cost & Chemical</span> Calculator
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Accurately price MSLA & SLA liquid resin prints. Factor in raw bottle cost, model hollowing savings, support volume, IPA wash solvent replenishment, FEP release film degradation, and mono LCD screen wear.
      </p>
    </div>

    <!-- Interactive Calculator -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Input Controls (6 Cols) -->
      <div class="lg:col-span-6 bg-[#0e1628] border border-white/10 rounded-2xl p-6 shadow-xl space-y-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-pink-400 font-mono">
          Resin Job Parameters
        </h2>

        <div class="space-y-4 text-xs">
          <!-- Resin Bottle Price & Capacity -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="resinBottlePrice" class="block font-medium text-slate-300 mb-1">Resin Bottle Price ($):</label>
              <input type="number" id="resinBottlePrice" value="26.99" step="1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>
            <div>
              <label for="resinBottleSize" class="block font-medium text-slate-300 mb-1">Bottle Volume (mL / g):</label>
              <input type="number" id="resinBottleSize" value="1000" step="500" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>
          </div>

          <!-- Model Volume & Supports -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="resinModelMl" class="block font-medium text-slate-300 mb-1">Model Slicer Volume (mL):</label>
              <input type="number" id="resinModelMl" value="65" step="5" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
              <span class="text-[11px] text-slate-400 block mt-1">From Chitubox or Lychee</span>
            </div>
            <div>
              <label for="resinSupportPct" class="block font-medium text-slate-300 mb-1">Supports Overhead (%):</label>
              <input type="number" id="resinSupportPct" value="20" step="5" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
              <span class="text-[11px] text-slate-400 block mt-1">Default ~15% to 25%</span>
            </div>
          </div>

          <!-- Print Time -->
          <div>
            <label for="resinPrintHours" class="block font-medium text-slate-300 mb-1">Print Exposure Time (Hours):</label>
            <input type="number" id="resinPrintHours" value="4.5" step="0.5" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
          </div>

          <!-- Chemical & Consumables Overhead -->
          <div class="pt-2 border-t border-white/5 space-y-3">
            <h3 class="font-bold text-white text-xs">Vat & Chemical Consumables</h3>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="resinIpaCost" class="block text-slate-400 mb-1">IPA Wash Solvent ($):</label>
                <input type="number" id="resinIpaCost" value="0.75" step="0.1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-white font-mono text-sm" />
                <span class="text-[10px] text-slate-500 block mt-1">Alcohol replenishment</span>
              </div>
              <div>
                <label for="resinFepCost" class="block text-slate-400 mb-1">FEP / Screen Wear ($):</label>
                <input type="number" id="resinFepCost" value="0.60" step="0.1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-white font-mono text-sm" />
                <span class="text-[10px] text-slate-500 block mt-1">Film & UV LCD lifespan</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Result Card (6 Cols) -->
      <div class="lg:col-span-6 bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-pink-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-pink-300 font-semibold">Total Landed Resin Cost</span>
          <div class="flex items-baseline gap-2 mt-2">
            <span class="text-4xl sm:text-5xl font-black text-white font-mono" id="resinTotalCostDisplay">$3.46</span>
            <span class="text-sm text-slate-400">Total Print Cost</span>
          </div>
          <span class="text-xs text-slate-400 block font-mono mt-1" id="resinUnitCostDisplay">
            78.0 mL total liquid consumed ($0.0270/mL)
          </span>
        </div>

        <!-- Breakdown List -->
        <div class="border-t border-white/10 pt-4 space-y-2.5 text-xs font-mono">
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">Model Photopolymer (65 mL):</span>
            <span id="resinModelCostDisplay" class="font-bold text-white">$1.75</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">Supports Photopolymer (13 mL):</span>
            <span id="resinSupportCostDisplay" class="font-bold text-white">$0.35</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">IPA Solvent Depletion:</span>
            <span id="resinIpaDisplay" class="font-bold text-white">$0.75</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">FEP Release Film & Screen Wear:</span>
            <span id="resinFepDisplay" class="font-bold text-white">$0.60</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">UV Wash & Cure Electricity:</span>
            <span id="resinElecDisplay" class="font-bold text-white">$0.04</span>
          </div>
        </div>

        <!-- Suggested Client Price -->
        <div class="p-4 rounded-xl bg-pink-950/40 border border-pink-500/30 space-y-1">
          <div class="flex justify-between items-center">
            <span class="font-bold text-pink-300 text-xs">Recommended Client Quote:</span>
            <span class="text-emerald-400 font-mono text-xs font-semibold">3.0x Markup</span>
          </div>
          <div class="text-2xl font-black text-white font-mono" id="resinClientPrice">$10.38</div>
          <span class="text-[11px] text-slate-400 block">Yields $6.92 net profit per print job.</span>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">Resin 3D Printing Cost FAQ</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {faqs.map((faq) => (
          <div class="p-5 rounded-2xl bg-[#0e1628] border border-white/10 space-y-2">
            <h3 class="text-sm font-bold text-white">{faq.question}</h3>
            <p class="text-xs text-slate-300 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  const priceInput = document.getElementById('resinBottlePrice') as HTMLInputElement;
  const sizeInput = document.getElementById('resinBottleSize') as HTMLInputElement;
  const modelInput = document.getElementById('resinModelMl') as HTMLInputElement;
  const supportInput = document.getElementById('resinSupportPct') as HTMLInputElement;
  const hoursInput = document.getElementById('resinPrintHours') as HTMLInputElement;
  const ipaInput = document.getElementById('resinIpaCost') as HTMLInputElement;
  const fepInput = document.getElementById('resinFepCost') as HTMLInputElement;

  const totalCostDisplay = document.getElementById('resinTotalCostDisplay');
  const unitCostDisplay = document.getElementById('resinUnitCostDisplay');
  const modelCostDisplay = document.getElementById('resinModelCostDisplay');
  const supportCostDisplay = document.getElementById('resinSupportCostDisplay');
  const ipaDisplay = document.getElementById('resinIpaDisplay');
  const fepDisplay = document.getElementById('resinFepDisplay');
  const elecDisplay = document.getElementById('resinElecDisplay');
  const clientPrice = document.getElementById('resinClientPrice');

  function calculateResin() {
    const bottlePrice = parseFloat(priceInput.value) || 27;
    const bottleSize = Math.max(1, parseFloat(sizeInput.value) || 1000);
    const modelMl = parseFloat(modelInput.value) || 0;
    const supportPct = (parseFloat(supportInput.value) || 0) / 100;
    const hours = parseFloat(hoursInput.value) || 0;
    const ipaCost = parseFloat(ipaInput.value) || 0;
    const fepCost = parseFloat(fepInput.value) || 0;

    const costPerMl = bottlePrice / bottleSize;
    const supportMl = modelMl * supportPct;
    const totalMl = modelMl + supportMl;

    const modelCost = modelMl * costPerMl;
    const supportCost = supportMl * costPerMl;
    const elecCost = (55 / 1000) * hours * 0.16; // 55W average MSLA power

    const totalLanded = modelCost + supportCost + ipaCost + fepCost + elecCost;
    const recommendedPrice = totalLanded * 3.0;

    if (totalCostDisplay) totalCostDisplay.textContent = `$${totalLanded.toFixed(2)}`;
    if (unitCostDisplay) unitCostDisplay.textContent = `${totalMl.toFixed(1)} mL total liquid consumed ($${costPerMl.toFixed(4)}/mL)`;
    if (modelCostDisplay) modelCostDisplay.textContent = `$${modelCost.toFixed(2)}`;
    if (supportCostDisplay) supportCostDisplay.textContent = `$${supportCost.toFixed(2)}`;
    if (ipaDisplay) ipaDisplay.textContent = `$${ipaCost.toFixed(2)}`;
    if (fepDisplay) fepDisplay.textContent = `$${fepCost.toFixed(2)}`;
    if (elecDisplay) elecDisplay.textContent = `$${elecCost.toFixed(2)}`;
    if (clientPrice) clientPrice.textContent = `$${recommendedPrice.toFixed(2)}`;
  }

  [priceInput, sizeInput, modelInput, supportInput, hoursInput, ipaInput, fepInput].forEach(inp => {
    inp?.addEventListener('input', calculateResin);
  });

  calculateResin();
</script>
