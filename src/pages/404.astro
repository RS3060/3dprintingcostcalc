---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404: Toolpath Not Found | 3DPrintingCostCalc.com"
  description="Layer shift detected! The requested 3D printing calculator page or resource does not exist on this build platform."
  noindex={true}
  breadcrumbs={[
    { name: 'Home', item: 'https://3dprintingcostcalc.com/' },
    { name: '404 Not Found', item: 'https://3dprintingcostcalc.com/404/' }
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-center space-y-10">
    
    <!-- 404 Visual Badge & Graphic -->
    <div class="relative inline-block">
      <!-- Glow effect -->
      <div class="absolute -inset-4 bg-cyan-500/20 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative inline-flex flex-col items-center">
        <!-- Technical 3D Printing Error Icon -->
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-[#0e1628] border-2 border-cyan-500/40 flex items-center justify-center text-cyan-400 shadow-2xl glow-cyan mb-4">
          <svg class="w-12 h-12 sm:w-14 sm:h-14 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-950/70 text-cyan-300 border border-cyan-800/50">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping" aria-hidden="true"></span>
          <span>Status 404 · Layer Shift Detected</span>
        </div>
      </div>
    </div>

    <!-- Main Title & Description -->
    <div class="space-y-4 max-w-2xl mx-auto">
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white">
        Toolpath <span class="bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">Not Found</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        The coordinates or file you requested are not on this build plate. The URL may have shifted, the slicer path was purged, or the page was relocated.
      </p>
    </div>

    <!-- Diagnostic Terminal Box -->
    <div class="max-w-lg mx-auto text-left bg-[#0c1220] border border-white/10 rounded-2xl p-4 sm:p-5 shadow-2xl font-mono text-xs text-slate-300 space-y-2">
      <div class="flex items-center justify-between pb-2 border-b border-white/5 text-[11px] text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="ml-2">terminal-output.log</span>
        </span>
        <span class="text-rose-400 font-bold">ERROR_E404</span>
      </div>
      <div class="space-y-1 text-slate-400 text-[11px] sm:text-xs">
        <p><span class="text-cyan-400">&gt;</span> G28 X0 Y0 Z0 <span class="text-slate-400">; Auto-homing axes</span></p>
        <p><span class="text-cyan-400">&gt;</span> M104 S0 ; Extruder heater cooldown</p>
        <p><span class="text-cyan-400">&gt;</span> M140 S0 ; Heated bed shutdown</p>
        <p class="text-rose-400 font-semibold"><span class="text-rose-500">&gt;</span> [Fatal Exception]: Target toolpath out of printable volume envelope.</p>
        <p class="text-cyan-300">&gt; Re-routing user to primary calibration tools...</p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <a
        href="/"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-cyan-700 hover:bg-cyan-600 text-white font-bold text-sm tracking-wide shadow-lg shadow-cyan-900/40 transition-all hover:scale-105 inline-flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Return to 3D Print Cost Calculator</span>
      </a>

      <a
        href="/3d-printer-cost-calculator/"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#162035] hover:bg-[#1e2c48] text-slate-200 font-semibold text-sm border border-white/10 transition-colors inline-flex items-center justify-center gap-2"
      >
        <span>Printer TCO & Electricity</span>
        <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </div>

    <!-- Quick Navigation Directory -->
    <div class="pt-10 border-t border-white/10 text-left">
      <h2 class="text-lg font-bold text-white mb-4 text-center sm:text-left">
        Looking for one of our core 3D printing calculators?
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- 1. Job Cost -->
        <a href="/" class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-cyan-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>Job Cost Calculator</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Drag-and-drop .STL, .3MF, and .GCODE to compute grams, watts &amp; labor.</p>
        </a>

        <!-- 2. Printer TCO -->
        <a href="/3d-printer-cost-calculator/" class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-blue-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-blue-400">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span>3D Printer TCO Engine</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Hardware purchase price, monthly power draw &amp; break-even analysis.</p>
        </a>

        <!-- 3. Filament Cost -->
        <a href="/filament-cost-calculator/" class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-emerald-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Filament Cost &amp; Length</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Convert spool weight to meters for 1.75mm and 2.85mm filaments.</p>
        </a>

        <!-- 4. Spool Tare -->
        <a href="/spool-remaining-calculator/" class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-cyan-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>Spool Tare Weight DB</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Lookup empty spool weights to prevent running out of filament mid-print.</p>
        </a>

        <!-- 5. AMS Waste -->
        <a href="/multicolor-ams-waste-calculator/" class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-purple-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-purple-400">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            <span>AMS Purge Optimizer</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Calculate multi-color purge poop waste and plate batch savings.</p>
        </a>

        <!-- 6. Resin SLA -->
        <a href="/resin-3d-print-cost-calculator/" class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-amber-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-amber-400">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span>Resin SLA Cost Guide</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">MSLA photopolymer resin, IPA wash, and FEP film degradation costs.</p>
        </a>
      </div>
    </div>

  </div>
</Layout>
