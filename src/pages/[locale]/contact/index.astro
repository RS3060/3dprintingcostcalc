---
import { ALL_LOCALES, DEFAULT_LOCALE } from '../../../i18n/locales';

export function getStaticPaths() {
  return ALL_LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/contact/" />
    <link rel="canonical" href="https://3dprintingcostcalc.com/contact/" />
    <title>Redirecting to Contact Us...</title>
    <script is:inline>window.location.replace('/contact/');</script>
  </head>
  <body style="background:#080c15;color:#94a3b8;display:flex;align-items:center;justify-content:center;height:100vh;font-family:system-ui,sans-serif;margin:0;">
    <p>Redirecting to <a href="/contact/" style="color:#22d3ee;font-weight:bold;">Contact Us</a>...</p>
  </body>
</html>
