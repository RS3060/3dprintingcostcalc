---
import PrinterTcoContent from '../../../components/pages/PrinterTcoContent.astro';
import { ALL_LOCALES, DEFAULT_LOCALE } from '../../../i18n/locales';

export function getStaticPaths() {
  return ALL_LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
---
<PrinterTcoContent locale={locale} />
