---
import '../styles/global.css';
import {
  LOCALES,
  ALL_LOCALES,
  DEFAULT_LOCALE,
  getCleanPath,
  getLocalizedPath,
  getLocaleFromPath,
  type LocaleCode,
} from '../i18n/locales';
import { getTranslations } from '../i18n/translations';
import LanguageSelector from '../components/LanguageSelector.astro';

export interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalUrl?: string;
  keywords?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  author?: string;
  noindex?: boolean;
  faqList?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; item: string }>;
  showLanguageSelector?: boolean;
}

const {
  title,
  description,
  locale,
  keywords = 'filament cost calculator, 3d print cost calculator, 3d printing cost calculator, 3d print calculator, 3d printer cost calculator, filament calculator, 3d print price calculator',
  image = 'https://3dprintingcostcalc.com/og-image.png',
  imageAlt = '3DPrintingCostCalc.com - Pro Maker 3D Print Cost Calculator Suite',
  ogType = 'website',
  author = '3DPrintingCostCalc.com',
  noindex = false,
  faqList = [],
  breadcrumbs,
  showLanguageSelector = true,
} = Astro.props;

// Determine current locale
const currentLocale = (locale as LocaleCode) || getLocaleFromPath(Astro.url.pathname);
const locInfo = LOCALES[currentLocale] || LOCALES[DEFAULT_LOCALE];
const t = getTranslations(currentLocale);

// Calculate canonical & clean path
const cleanPath = getCleanPath(Astro.url.pathname);
const canonicalUrl =
  Astro.props.canonicalUrl ||
  (currentLocale === DEFAULT_LOCALE
    ? `https://3dprintingcostcalc.com${cleanPath}`
    : `https://3dprintingcostcalc.com/${currentLocale}${cleanPath}`);

// Default breadcrumbs
const activeBreadcrumbs = breadcrumbs || [
  {
    name: t.nav.jobCost,
    item: currentLocale === DEFAULT_LOCALE ? 'https://3dprintingcostcalc.com/' : `https://3dprintingcostcalc.com/${currentLocale}/`,
  },
];

// Schema graph construction
const schemaGraph: any[] = [
  {
    '@type': 'WebSite',
    '@id': 'https://3dprintingcostcalc.com/#website',
    url: currentLocale === DEFAULT_LOCALE ? 'https://3dprintingcostcalc.com/' : `https://3dprintingcostcalc.com/${currentLocale}/`,
    name: '3D Printing Cost Calculator',
    inLanguage: locInfo.htmlLang,
    description: description,
  },
  {
    '@type': 'Organization',
    '@id': 'https://3dprintingcostcalc.com/#organization',
    name: '3D Printing Cost Calculator',
    url: 'https://3dprintingcostcalc.com/',
    logo: 'https://3dprintingcostcalc.com/apple-touch-icon.png',
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${canonicalUrl}#software`,
    name: title,
    url: canonicalUrl,
    inLanguage: locInfo.htmlLang,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'All Web Browsers',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: locInfo.currencyCode,
    },
    description: description,
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumbs`,
    itemListElement: activeBreadcrumbs.map((b, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: b.name,
      item: b.item,
    })),
  },
];

if (faqList.length > 0) {
  schemaGraph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    inLanguage: locInfo.htmlLang,
    mainEntity: faqList.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

const jsonLdContent = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
});
---

<!doctype html>
<html lang={locInfo.htmlLang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- Google tag (gtag.js) - High-Performance Deferred Loading -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z1H2XFX98K');

      (function() {
        var scriptLoaded = false;
        function loadGtag() {
          if (scriptLoaded) return;
          scriptLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-Z1H2XFX98K';
          document.head.appendChild(s);
        }

        var events = ['pointerdown', 'touchstart', 'scroll', 'keydown', 'mousemove'];
        function onInteraction() {
          events.forEach(function(e) {
            window.removeEventListener(e, onInteraction, { passive: true });
          });
          loadGtag();
        }
        events.forEach(function(e) {
          window.addEventListener(e, onInteraction, { passive: true, once: true });
        });

        // Fallback for non-interactive sessions: trigger when browser is idle after load
        window.addEventListener('load', function() {
          setTimeout(function() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadGtag, { timeout: 2000 });
            } else {
              setTimeout(loadGtag, 1000);
            }
          }, 4500);
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="publisher" content="3DPrintingCostCalc.com" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Complete Multilingual SEO Alternate Hreflang Tags -->
    {!noindex && (
      showLanguageSelector ? (
        <>
          <link rel="alternate" hreflang="x-default" href={`https://3dprintingcostcalc.com${cleanPath}`} />
          {ALL_LOCALES.map((loc) => {
            const alternateUrl =
              loc === DEFAULT_LOCALE
                ? `https://3dprintingcostcalc.com${cleanPath}`
                : `https://3dprintingcostcalc.com/${loc}${cleanPath}`;
            return <link rel="alternate" hreflang={loc} href={alternateUrl} />;
          })}
        </>
      ) : (
        <>
          <link rel="alternate" hreflang="x-default" href={`https://3dprintingcostcalc.com${cleanPath}`} />
          <link rel="alternate" hreflang="en" href={`https://3dprintingcostcalc.com${cleanPath}`} />
        </>
      )
    )}

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <!-- Web App & Mobile Optimization -->
    <meta name="application-name" content="3D Printing Cost Calculator" />
    <meta name="apple-mobile-web-app-title" content="3D Cost Calc" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="3D Printing Cost Calculator" />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={locInfo.ogLocale} />
    {ALL_LOCALES.filter((l) => l !== currentLocale).map((otherLoc) => (
      <meta property="og:locale:alternate" content={LOCALES[otherLoc].ogLocale} />
    ))}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:site" content="@3DPrintCostCalc" />
    <meta name="twitter:creator" content="@3DPrintCostCalc" />

    <!-- Favicon & Icons -->
    <meta name="theme-color" content="#080c15" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-192.png?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={jsonLdContent} />

    <!-- Inline script to prevent theme flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      }
    </script>
  </head>
  <body class="bg-[#080c15] text-slate-100 min-h-screen flex flex-col selection:bg-cyan-500 selection:text-black">
    <!-- Top Decorative RGB Layer Line -->
    <div class="h-1 w-full layer-line-rgb no-print" aria-hidden="true"></div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#080c15]/90 backdrop-blur-md transition-colors no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
        <!-- Logo & Branding -->
        <a href={getLocalizedPath('/', currentLocale)} class="flex items-center gap-2 sm:gap-2.5 group min-w-0" aria-label="3DPrintingCostCalc.com Home">
          <div class="logo-badge-3d w-8 h-8 shrink-0 flex items-center justify-center font-bold text-sm tracking-tight border group-hover:scale-105 transition-transform" aria-hidden="true">3D</div>
          <div class="truncate">
            <span class="text-sm sm:text-base font-bold tracking-tight text-white group-hover:text-cyan-400 transition-colors block truncate">
              3DPrintingCostCalc<span class="text-slate-400">.com</span>
            </span>
            <span class="text-[10px] sm:text-[11px] block text-slate-400 font-mono tracking-wider uppercase truncate">{t.nav.proMakerSuite}</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-1 text-sm font-medium" aria-label="Main navigation">
          <a data-nav="jobCost" href={getLocalizedPath('/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-white hover:bg-white/5 transition-colors">{t.nav.jobCost}</a>
          <a data-nav="printerTco" href={getLocalizedPath('/3d-printer-cost-calculator/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-white hover:bg-white/5 transition-colors">{t.nav.printerTco}</a>
          <a data-nav="filamentLength" href={getLocalizedPath('/filament-cost-calculator/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-white hover:bg-white/5 transition-colors">{t.nav.filamentLength}</a>
          <a data-nav="spoolTare" href={getLocalizedPath('/spool-remaining-calculator/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-white hover:bg-white/5 transition-colors">{t.nav.spoolTare}</a>
          <a data-nav="amsWaste" href={getLocalizedPath('/multicolor-ams-waste-calculator/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-white hover:bg-white/5 transition-colors">{t.nav.amsWaste}</a>
          <a data-nav="resinSla" href={getLocalizedPath('/resin-3d-print-cost-calculator/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-white hover:bg-white/5 transition-colors">{t.nav.resinSla}</a>
        </nav>

        <!-- Right Side Actions: Language Selector, Theme Toggle & Mobile Menu Trigger -->
        <div class="flex items-center gap-1 sm:gap-2 shrink-0">
          <!-- Language Dropdown -->
          {showLanguageSelector && (
            <LanguageSelector currentLocale={currentLocale} currentPathname={Astro.url.pathname} />
          )}

          <!-- Light/Dark Toggle -->
          <button id="themeToggleBtn" aria-label="Toggle color theme" class="p-2 text-slate-400 hover:text-white hover:bg-white/5 transition-colors cursor-pointer rounded">
            <svg id="themeIconSun" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
            <svg id="themeIconMoon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
          </button>

          <!-- Mobile Menu Button -->
          <button
            id="mobileMenuBtn"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobileMenuDrawer"
            class="lg:hidden p-2 text-slate-400 hover:text-white hover:bg-white/5 transition-colors cursor-pointer rounded"
          >
            <svg id="menuIconOpen" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
            </svg>
            <svg id="menuIconClose" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation Drawer -->
      <nav id="mobileMenuDrawer" class="hidden lg:hidden border-t border-white/10 bg-[#0c1220] px-4 py-4 space-y-4 max-h-[85vh] overflow-y-auto" aria-label="Mobile navigation">
        <!-- Language Switcher in Mobile Drawer -->
        {showLanguageSelector && (
          <div class="border-b border-white/10 pb-3">
            <LanguageSelector currentLocale={currentLocale} currentPathname={Astro.url.pathname} isMobileDrawer={true} />
          </div>
        )}

        <div>
          <span data-nav="calculatorsTitle" class="text-[11px] font-mono uppercase tracking-wider text-cyan-400 block mb-2 px-3">{t.nav.calculators}</span>
          <div class="space-y-1">
            <a data-nav="jobCost" href={getLocalizedPath('/', currentLocale)} class="block px-3 py-2 text-sm font-medium text-slate-200 hover:bg-white/5 rounded transition-colors">{t.nav.jobCost}</a>
            <a data-nav="printerTco" href={getLocalizedPath('/3d-printer-cost-calculator/', currentLocale)} class="block px-3 py-2 text-sm font-medium text-slate-200 hover:bg-white/5 rounded transition-colors">{t.nav.printerTco}</a>
            <a data-nav="filamentLength" href={getLocalizedPath('/filament-cost-calculator/', currentLocale)} class="block px-3 py-2 text-sm font-medium text-slate-200 hover:bg-white/5 rounded transition-colors">{t.nav.filamentLength}</a>
            <a data-nav="spoolTare" href={getLocalizedPath('/spool-remaining-calculator/', currentLocale)} class="block px-3 py-2 text-sm font-medium text-slate-200 hover:bg-white/5 rounded transition-colors">{t.nav.spoolTare}</a>
            <a data-nav="amsWaste" href={getLocalizedPath('/multicolor-ams-waste-calculator/', currentLocale)} class="block px-3 py-2 text-sm font-medium text-slate-200 hover:bg-white/5 rounded transition-colors">{t.nav.amsWaste}</a>
            <a data-nav="resinSla" href={getLocalizedPath('/resin-3d-print-cost-calculator/', currentLocale)} class="block px-3 py-2 text-sm font-medium text-slate-200 hover:bg-white/5 rounded transition-colors">{t.nav.resinSla}</a>
          </div>
        </div>

        <div class="border-t border-white/5 pt-3">
          <span data-nav="machineProfilesTitle" class="text-[11px] font-mono uppercase tracking-wider text-slate-400 block mb-2 px-3">{t.nav.machineProfiles}</span>
          <div class="grid grid-cols-2 gap-1 text-xs">
            <a href={getLocalizedPath('/cost-calculator/bambu-lab-p1s/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">Bambu P1S</a>
            <a href={getLocalizedPath('/cost-calculator/bambu-lab-a1-mini/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">Bambu A1 Mini</a>
            <a href={getLocalizedPath('/cost-calculator/bambu-lab-x1-carbon/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">Bambu X1C</a>
            <a href={getLocalizedPath('/cost-calculator/prusa-mk4s/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">Prusa MK4S</a>
            <a href={getLocalizedPath('/cost-calculator/creality-ender-3-v3-se/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">Ender-3 V3</a>
            <a href={getLocalizedPath('/cost-calculator/elegoo-saturn-4-ultra/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">Saturn 4 Ultra</a>
          </div>
        </div>

        <div class="border-t border-white/5 pt-3">
          <span data-nav="materialsGuidesTitle" class="text-[11px] font-mono uppercase tracking-wider text-slate-400 block mb-2 px-3">{t.nav.materialsGuides}</span>
          <div class="grid grid-cols-2 gap-1 text-xs">
            <a href={getLocalizedPath('/filament-cost/pla/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">PLA Guide</a>
            <a href={getLocalizedPath('/filament-cost/petg/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">PETG Guide</a>
            <a href={getLocalizedPath('/filament-cost/abs/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">ABS Guide</a>
            <a href={getLocalizedPath('/filament-cost/tpu-95a/', currentLocale)} class="px-3 py-1.5 text-slate-300 hover:text-cyan-400 transition-colors">TPU Guide</a>
          </div>
        </div>

        <div class="border-t border-white/5 pt-3 flex items-center justify-between px-3 text-xs text-slate-400">
          <a data-nav="privacy" href="/privacy/" class="hover:text-cyan-400 transition-colors">{t.nav.privacy}</a>
          <span>·</span>
          <a data-nav="terms" href="/terms/" class="hover:text-cyan-400 transition-colors">{t.nav.terms}</a>
          <span>·</span>
          <a data-nav="contact" href="/contact/" class="hover:text-cyan-400 transition-colors">{t.nav.contact}</a>
        </div>
      </nav>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 print-bed-pattern">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/10 bg-[#060910] text-slate-400 text-sm py-12 no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <!-- Col 1: About & Privacy -->
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="logo-badge-3d w-7 h-7 flex items-center justify-center font-bold text-xs tracking-tight border" aria-hidden="true">3D</div>
              <span class="font-semibold text-white">3DPrintingCostCalc.com</span>
            </div>
            <p id="footerAboutDesc" class="text-xs text-slate-400 leading-relaxed">
              {t.footer.aboutDesc}
            </p>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono bg-emerald-950/60 text-emerald-400 border border-emerald-800/40 rounded">
              <span class="w-1.5 h-1.5 bg-emerald-400 animate-pulse" aria-hidden="true"></span>
              <span id="footerClientBadge">{t.footer.clientSideBadge}</span>
            </div>
          </div>

          <!-- Col 2: Core Calculators -->
          <div>
            <h3 id="footerColCalculators" class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">{t.footer.calculatorsCol}</h3>
            <ul class="space-y-2 text-xs">
              <li><a data-nav="jobCost" href={getLocalizedPath('/', currentLocale)} class="hover:text-cyan-400 transition-colors">{t.nav.jobCost}</a></li>
              <li><a data-nav="printerTco" href={getLocalizedPath('/3d-printer-cost-calculator/', currentLocale)} class="hover:text-cyan-400 transition-colors">{t.nav.printerTco}</a></li>
              <li><a data-nav="filamentLength" href={getLocalizedPath('/filament-cost-calculator/', currentLocale)} class="hover:text-cyan-400 transition-colors">{t.nav.filamentLength}</a></li>
              <li><a data-nav="spoolTare" href={getLocalizedPath('/spool-remaining-calculator/', currentLocale)} class="hover:text-cyan-400 transition-colors">{t.nav.spoolTare}</a></li>
              <li><a data-nav="amsWaste" href={getLocalizedPath('/multicolor-ams-waste-calculator/', currentLocale)} class="hover:text-cyan-400 transition-colors">{t.nav.amsWaste}</a></li>
              <li><a data-nav="resinSla" href={getLocalizedPath('/resin-3d-print-cost-calculator/', currentLocale)} class="hover:text-cyan-400 transition-colors">{t.nav.resinSla}</a></li>
            </ul>
          </div>

          <!-- Col 3: Popular Printer Profiles -->
          <div>
            <h3 id="footerColProfiles" class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">{t.footer.machineProfilesCol}</h3>
            <ul class="space-y-2 text-xs">
              <li><a href={getLocalizedPath('/cost-calculator/bambu-lab-p1s/', currentLocale)} class="hover:text-cyan-400 transition-colors">Bambu Lab P1S</a></li>
              <li><a href={getLocalizedPath('/cost-calculator/bambu-lab-a1-mini/', currentLocale)} class="hover:text-cyan-400 transition-colors">Bambu A1 Mini</a></li>
              <li><a href={getLocalizedPath('/cost-calculator/bambu-lab-x1-carbon/', currentLocale)} class="hover:text-cyan-400 transition-colors">Bambu X1 Carbon</a></li>
              <li><a href={getLocalizedPath('/cost-calculator/prusa-mk4s/', currentLocale)} class="hover:text-cyan-400 transition-colors">Original Prusa MK4S</a></li>
              <li><a href={getLocalizedPath('/cost-calculator/creality-ender-3-v3-se/', currentLocale)} class="hover:text-cyan-400 transition-colors">Creality Ender-3 V3</a></li>
              <li><a href={getLocalizedPath('/cost-calculator/elegoo-saturn-4-ultra/', currentLocale)} class="hover:text-cyan-400 transition-colors">Elegoo Saturn 4 Ultra</a></li>
            </ul>
          </div>

          <!-- Col 4: Materials & Legal -->
          <div>
            <h3 id="footerColMaterials" class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">{t.footer.materialsCol}</h3>
            <ul class="space-y-2 text-xs">
              <li><a href={getLocalizedPath('/filament-cost/pla/', currentLocale)} class="hover:text-cyan-400 transition-colors">PLA Guide</a></li>
              <li><a href={getLocalizedPath('/filament-cost/petg/', currentLocale)} class="hover:text-cyan-400 transition-colors">PETG Guide</a></li>
              <li><a href={getLocalizedPath('/filament-cost/abs/', currentLocale)} class="hover:text-cyan-400 transition-colors">ABS Guide</a></li>
              <li><a data-nav="privacy" href="/privacy/" class="hover:text-cyan-400 transition-colors">{t.nav.privacy}</a></li>
              <li><a data-nav="terms" href="/terms/" class="hover:text-cyan-400 transition-colors">{t.nav.terms}</a></li>
              <li><a data-nav="contact" href="/contact/" class="hover:text-cyan-400 transition-colors">{t.nav.contact}</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-white/5 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
          <p id="footerCopyright">{t.footer.copyrightNotice}</p>
          <p id="footerBuiltFor" class="text-slate-400">{t.footer.builtFor}</p>
        </div>
      </div>
    </footer>

    <!-- Global Client Script for Theme & Navigation -->
    <script>
      const themeBtn = document.getElementById('themeToggleBtn');
      const sunIcon = document.getElementById('themeIconSun');
      const moonIcon = document.getElementById('themeIconMoon');
      const mobileBtn = document.getElementById('mobileMenuBtn');
      const mobileDrawer = document.getElementById('mobileMenuDrawer');
      const menuIconOpen = document.getElementById('menuIconOpen');
      const menuIconClose = document.getElementById('menuIconClose');

      function updateThemeIcons() {
        const isLight = document.documentElement.classList.contains('light');
        if (isLight) {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
        } else {
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
        }
      }

      themeBtn?.addEventListener('click', () => {
        const isLight = document.documentElement.classList.contains('light');
        if (isLight) {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          localStorage.setItem('theme', 'light');
        }
        updateThemeIcons();
      });

      function toggleMobileDrawer(forceClose?: boolean) {
        if (!mobileDrawer || !mobileBtn) return;
        const willOpen = forceClose !== undefined ? !forceClose : mobileDrawer.classList.contains('hidden');
        if (willOpen) {
          mobileDrawer.classList.remove('hidden');
          mobileBtn.setAttribute('aria-expanded', 'true');
          menuIconOpen?.classList.add('hidden');
          menuIconClose?.classList.remove('hidden');
        } else {
          mobileDrawer.classList.add('hidden');
          mobileBtn.setAttribute('aria-expanded', 'false');
          menuIconOpen?.classList.remove('hidden');
          menuIconClose?.classList.add('hidden');
        }
      }

      mobileBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileDrawer();
      });

      // Close on outside click or Escape key
      document.addEventListener('click', (e) => {
        if (!mobileDrawer?.contains(e.target as Node) && !mobileBtn?.contains(e.target as Node)) {
          toggleMobileDrawer(true);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleMobileDrawer(true);
        }
      });

      updateThemeIcons();
    </script>
  </body>
</html>
