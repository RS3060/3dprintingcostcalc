---
import Layout from '../layouts/Layout.astro';
import PrintCostCalculator from './PrintCostCalculator.astro';
import { getTranslations } from '../i18n/translations';
import { LOCALES } from '../i18n/locales';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);
const locInfo = LOCALES[locale] || LOCALES.en;
const currSym = locInfo.currency;
---

<Layout
  title={t.home.metaTitle}
  description={t.home.metaDescription}
  keywords={t.home.metaKeywords}
  locale={locale}
  faqList={t.home.faqs}
>
  <!-- Hero Section -->
  <section class="relative pt-10 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Ambient glow backdrop -->
    <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-3/4 max-w-3xl h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="text-center max-w-3xl mx-auto space-y-4 mb-8">


      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight">
        {t.home.heroTitle} <span class="bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">{t.home.heroGradient}</span>
      </h1>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        {t.home.heroSubtitle}
      </p>
    </div>

    <!-- Interactive Flagship Calculator Component -->
    <PrintCostCalculator locale={locale} />
  </section>

  <!-- Deep Engineering & Economic Guide Content -->
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-slate-300 space-y-14 border-t border-white/10">
    
    <!-- Section 1: The Physics of 3D Printing Economics -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-sm font-mono font-bold">01</span>
        {t.home.guide.section1Title}
      </h2>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section1P1}
      </p>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section1P2}
      </p>
      
      <!-- Math Block -->
      <div class="p-5 rounded-2xl bg-[#0e1628] border border-cyan-500/20 font-mono text-xs sm:text-sm text-cyan-300 overflow-x-auto shadow-lg">
        <code>{t.home.guide.formulaTotal}</code>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 text-xs sm:text-sm">
        <div class="p-5 rounded-2xl bg-[#0e1628] border border-white/5 space-y-3">
          <h3 class="font-bold text-white text-base flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            {t.home.guide.f1Title}
          </h3>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f1Desc}
          </p>
          <div class="font-mono bg-black/40 p-2.5 rounded text-cyan-300">
            {t.home.guide.f1Formula}
          </div>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f1Note}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#0e1628] border border-white/5 space-y-3">
          <h3 class="font-bold text-white text-base flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            {t.home.guide.f2Title}
          </h3>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f2Desc}
          </p>
          <div class="font-mono bg-black/40 p-2.5 rounded text-amber-300">
            {t.home.guide.f2Formula}
          </div>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f2Note}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#0e1628] border border-white/5 space-y-3">
          <h3 class="font-bold text-white text-base flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            {t.home.guide.f3Title}
          </h3>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f3Desc}
          </p>
          <div class="font-mono bg-black/40 p-2.5 rounded text-blue-300">
            {t.home.guide.f3Formula}
          </div>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f3Note}
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#0e1628] border border-white/5 space-y-3">
          <h3 class="font-bold text-white text-base flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            {t.home.guide.f4Title}
          </h3>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f4Desc}
          </p>
          <div class="font-mono bg-black/40 p-2.5 rounded text-emerald-300">
            {t.home.guide.f4Formula}
          </div>
          <p class="text-slate-400 leading-relaxed">
            {t.home.guide.f4Note}
          </p>
        </div>
      </div>
    </section>

    <!-- Section 2: Real-World Electricity Tests -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-sm font-mono font-bold">02</span>
        {t.home.guide.section2Title}
      </h2>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section2P1}
      </p>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section2P2}
      </p>
    </section>

    <!-- Section 3: Machine Depreciation & Capital Reserve -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center text-sm font-mono font-bold">03</span>
        {t.home.guide.section3Title}
      </h2>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section3P1}
      </p>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section3P2}
      </p>
    </section>

    <!-- Section 4: Multi-Color AMS Purge Waste -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-sm font-mono font-bold">04</span>
        {t.home.guide.section4Title}
      </h2>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section4P1}
      </p>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section4P2}
      </p>
    </section>

    <!-- Section 5: Commercial Pricing & Margins -->
    <section class="space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-sm font-mono font-bold">05</span>
        {t.home.guide.section5Title}
      </h2>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section5P1}
      </p>
      <p class="leading-relaxed text-slate-300">
        {t.home.guide.section5P2}
      </p>
    </section>

    <!-- Section 6: FAQs Section -->
    <section class="space-y-6 pt-4 border-t border-white/10">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
          Frequently Asked Questions (FAQ)
        </h2>
      </div>

      <div class="space-y-3">
        {t.home.faqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-[#0e1628] border border-white/10 transition-all hover:border-cyan-500/30">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-white text-base gap-4">
              <span class="flex items-center gap-3">
                <span class="text-cyan-400 font-mono text-xs px-2 py-0.5 rounded bg-cyan-950/60 border border-cyan-800/40 shrink-0">Q{index + 1}</span>
                <span class="text-slate-100 group-hover:text-cyan-300 transition-colors">{faq.question}</span>
              </span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-white/5 text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

  </article>
</Layout>
