---
import Layout from '../../layouts/Layout.astro';
import printers from '../../data/printers.json';
import { getPageTranslations } from '../../i18n/pageTranslations';
import { getTranslations } from '../../i18n/translations';
import { LOCALES, DEFAULT_LOCALE, getLocalizedPath, type LocaleCode } from '../../i18n/locales';

export interface Props {
  locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const currentLocale = (locale as LocaleCode) || DEFAULT_LOCALE;
const locInfo = LOCALES[currentLocale] || LOCALES[DEFAULT_LOCALE];
const t = getTranslations(currentLocale);
const pageT = getPageTranslations(currentLocale).printerTco;
const curr = locInfo.currency;

const defaultPrice = currentLocale === 'zh' ? 5999 : (currentLocale === 'ja' ? 128000 : (currentLocale === 'ko' ? 1150000 : (currentLocale === 'pt' ? 4999 : (['fr', 'de', 'es', 'it'].includes(currentLocale) ? 849 : 849))));
const defaultSpoolCost = currentLocale === 'zh' ? 69 : (currentLocale === 'ja' ? 2800 : (currentLocale === 'ko' ? 24000 : (currentLocale === 'pt' ? 110 : (['fr', 'de', 'es', 'it'].includes(currentLocale) ? 20 : 20))));
const defaultOutsource = currentLocale === 'zh' ? 180 : (currentLocale === 'ja' ? 3800 : (currentLocale === 'ko' ? 35000 : (currentLocale === 'pt' ? 150 : (['fr', 'de', 'es', 'it'].includes(currentLocale) ? 30 : 30))));
const defaultElecRate = currentLocale === 'zh' ? 0.68 : (currentLocale === 'ja' ? 31.0 : (currentLocale === 'ko' ? 200.0 : (currentLocale === 'pt' ? 0.85 : (['fr', 'de', 'es', 'it'].includes(currentLocale) ? 0.28 : 0.16))));
---

<Layout
  title={pageT.metaTitle}
  description={pageT.metaDescription}
  keywords={pageT.metaKeywords}
  locale={currentLocale}
  faqList={pageT.faqs}
  breadcrumbs={[
    { name: t.nav.jobCost, item: getLocalizedPath('/', currentLocale) },
    { name: t.nav.printerTco, item: getLocalizedPath('/3d-printer-cost-calculator/', currentLocale) }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-blue-950/60 text-blue-300 border border-blue-800/40">
        {pageT.badge}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        {pageT.heroTitle} <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">{pageT.heroGradient}</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {pageT.heroSubtitle}
      </p>
    </div>

    <!-- Interactive TCO Calculator -->
    <div
      id="tcoRoot"
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
      data-currency={curr}
    >
      <!-- Input Controls (7 Cols) -->
      <div class="lg:col-span-7 bg-[#0e1628] border border-white/10 p-6 shadow-xl space-y-5 rounded-2xl">
        <h2 class="text-base font-bold text-white tracking-wide uppercase font-mono text-xs text-blue-400">
          {pageT.labels.inputsTitle}
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <!-- Printer Hardware Preset -->
          <div class="sm:col-span-2">
            <label for="tcoPrinterSelect" class="block font-medium text-slate-300 mb-1">{pageT.labels.selectPrinter}</label>
            <select id="tcoPrinterSelect" class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-sm text-white rounded-lg">
              <option value="custom">{pageT.labels.customPrinter}</option>
              {printers.map((p) => (
                <option value={p.slug} data-msrp={p.msrpUsd} data-watts={p.avgWattsPla}>
                  {p.brand} {p.model} ({curr}{p.msrpUsd} · {p.avgWattsPla}W)
                </option>
              ))}
            </select>
          </div>

          <!-- Custom Hardware Price -->
          <div>
            <label for="tcoHardwarePrice" class="block font-medium text-slate-300 mb-1">{pageT.labels.upfrontPrice}</label>
            <input type="number" id="tcoHardwarePrice" value={defaultPrice} class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-white font-mono text-sm rounded-lg" />
          </div>

          <!-- Printer Power Draw (Watts) -->
          <div>
            <label for="tcoPrinterWatts" class="block font-medium text-slate-300 mb-1">{pageT.labels.powerDraw}</label>
            <input type="number" id="tcoPrinterWatts" value="130" step="5" min="10" max="2500" class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-white font-mono text-sm rounded-lg" />
          </div>

          <!-- Average Print Hours Per Month -->
          <div>
            <label for="tcoMonthlyHours" class="block font-medium text-slate-300 mb-1">{pageT.labels.monthlyHours}</label>
            <input type="number" id="tcoMonthlyHours" value="120" class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-white font-mono text-sm rounded-lg" />
          </div>

          <!-- Monthly Spools -->
          <div>
            <label for="tcoSpoolsMonth" class="block font-medium text-slate-300 mb-1">{pageT.labels.spoolsMonth}</label>
            <input type="number" id="tcoSpoolsMonth" value="2" class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-white font-mono text-sm rounded-lg" />
          </div>

          <!-- Cost Per Spool -->
          <div>
            <label for="tcoSpoolCost" class="block font-medium text-slate-300 mb-1">{pageT.labels.spoolCost}</label>
            <input type="number" id="tcoSpoolCost" value={defaultSpoolCost} class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-white font-mono text-sm rounded-lg" />
          </div>

          <!-- Electricity Rate -->
          <div>
            <label for="tcoElecRate" class="block font-medium text-slate-300 mb-1">{pageT.labels.elecRate}</label>
            <input type="number" id="tcoElecRate" step="0.01" value={defaultElecRate} class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-white font-mono text-sm rounded-lg" />
          </div>

          <!-- Replacement Outsource Cost -->
          <div class="sm:col-span-2">
            <label for="tcoOutsourceCost" class="block font-medium text-slate-300 mb-1">{pageT.labels.outsourcedCost}</label>
            <input type="number" id="tcoOutsourceCost" value={defaultOutsource} class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-white font-mono text-sm rounded-lg" />
          </div>
        </div>
      </div>

      <!-- Results & TCO Projection (5 Cols) -->
      <div class="lg:col-span-5 bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-blue-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-blue-300 font-semibold">{pageT.labels.resultsTitle}</span>
          <div class="flex items-baseline gap-2 mt-2">
            <span class="text-4xl sm:text-5xl font-black text-white font-mono" id="tcoYear1Total">{curr}1,389</span>
            <span class="text-sm text-slate-400">{pageT.labels.firstYearCost}</span>
          </div>
          <span class="text-xs text-slate-400 block mt-1">{pageT.labels.monthlyRunCost} <strong class="text-cyan-400" id="tcoMonthlyOpEx">{curr}45.00</strong></span>
        </div>

        <!-- Breakdown List -->
        <div class="border-t border-white/10 pt-4 space-y-2.5 text-xs font-mono">
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{pageT.labels.upfrontPrice}</span>
            <span id="tcoHardwareDisplay" class="font-bold text-white">{curr}{defaultPrice}</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{pageT.labels.annualCost} (Filament):</span>
            <span id="tcoFilamentYearDisplay" class="font-bold text-white">{curr}480.00</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{pageT.labels.annualCost} (Power):</span>
            <span id="tcoElecYearDisplay" class="font-bold text-white">{curr}29.95</span>
          </div>
        </div>

        <!-- Break-Even Badge -->
        <div class="p-4 rounded-xl bg-blue-950/60 border border-blue-500/30 space-y-1.5">
          <span class="text-xs font-semibold text-blue-300 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            {pageT.labels.breakevenTitle}
          </span>
          <p class="text-xs text-slate-300">
            {pageT.labels.breakevenDesc}
          </p>
          <div class="text-2xl font-bold font-mono text-cyan-400" id="tcoBreakEvenParts">28 Parts</div>
          <p class="text-[11px] text-slate-400 font-mono" id="tcoBreakEvenMonths">{pageT.labels.breakevenMonths} ~3.2</p>
        </div>
      </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">{t.nav.printerTco} - FAQ</h2>
      <div class="space-y-3">
        {pageT.faqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-[#0e1628] border border-white/10 transition-all hover:border-cyan-500/30">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-white text-sm sm:text-base gap-4">
              <span class="flex items-center gap-3">
                <span class="text-cyan-400 font-mono text-xs px-2 py-0.5 rounded bg-cyan-950/60 border border-cyan-800/40 shrink-0">Q{index + 1}</span>
                <span class="text-slate-100 group-hover:text-cyan-300 transition-colors">{faq.question}</span>
              </span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-white/5 text-xs sm:text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import printers from '../../data/printers.json';

  const root = document.getElementById('tcoRoot');
  const curr = root?.dataset.currency || '$';

  const printerSelect = document.getElementById('tcoPrinterSelect') as HTMLSelectElement;
  const hardwarePriceInput = document.getElementById('tcoHardwarePrice') as HTMLInputElement;
  const printerWattsInput = document.getElementById('tcoPrinterWatts') as HTMLInputElement;
  const monthlyHoursInput = document.getElementById('tcoMonthlyHours') as HTMLInputElement;
  const spoolsMonthInput = document.getElementById('tcoSpoolsMonth') as HTMLInputElement;
  const spoolCostInput = document.getElementById('tcoSpoolCost') as HTMLInputElement;
  const elecRateInput = document.getElementById('tcoElecRate') as HTMLInputElement;
  const outsourceCostInput = document.getElementById('tcoOutsourceCost') as HTMLInputElement;

  const tcoYear1Total = document.getElementById('tcoYear1Total');
  const tcoMonthlyOpEx = document.getElementById('tcoMonthlyOpEx');
  const tcoHardwareDisplay = document.getElementById('tcoHardwareDisplay');
  const tcoFilamentYearDisplay = document.getElementById('tcoFilamentYearDisplay');
  const tcoElecYearDisplay = document.getElementById('tcoElecYearDisplay');
  const tcoBreakEvenParts = document.getElementById('tcoBreakEvenParts');
  const tcoBreakEvenMonths = document.getElementById('tcoBreakEvenMonths');

  function updateTCO() {
    if (!hardwarePriceInput || !printerWattsInput) return;
    const hardwareCost = parseFloat(hardwarePriceInput.value) || 0;
    const watts = parseFloat(printerWattsInput.value) || 130;
    const monthlyHours = parseFloat(monthlyHoursInput?.value || '0') || 0;
    const spoolsMonth = parseFloat(spoolsMonthInput?.value || '0') || 0;
    const spoolCost = parseFloat(spoolCostInput?.value || '0') || 0;
    const elecRate = parseFloat(elecRateInput?.value || '0.16') || 0.16;
    const outsourcePrice = parseFloat(outsourceCostInput?.value || '30') || 30;

    const monthlyFilamentCost = spoolsMonth * spoolCost;
    const monthlyKwh = (watts / 1000) * monthlyHours;
    const monthlyElecCost = monthlyKwh * elecRate;
    const monthlyMaintenance = 2.50;
    const monthlyOpEx = monthlyFilamentCost + monthlyElecCost + monthlyMaintenance;

    const year1Filament = monthlyFilamentCost * 12;
    const year1Elec = monthlyElecCost * 12;
    const year1Total = hardwareCost + year1Filament + year1Elec + 30;

    const inHousePartCost = (0.1 * spoolCost) + (2.5 * (watts / 1000) * elecRate);
    const savingsPerPart = Math.max(1, outsourcePrice - inHousePartCost);
    const breakEvenCount = Math.ceil(hardwareCost / savingsPerPart);
    const partsPerMonth = (spoolsMonth * 1000) / 100;
    const breakEvenMonths = partsPerMonth > 0 ? (breakEvenCount / partsPerMonth).toFixed(1) : 'N/A';

    if (tcoYear1Total) tcoYear1Total.textContent = `${curr}${Math.round(year1Total).toLocaleString()}`;
    if (tcoMonthlyOpEx) tcoMonthlyOpEx.textContent = `${curr}${monthlyOpEx.toFixed(2)}`;
    if (tcoHardwareDisplay) tcoHardwareDisplay.textContent = `${curr}${hardwareCost.toFixed(2)}`;
    if (tcoFilamentYearDisplay) tcoFilamentYearDisplay.textContent = `${curr}${year1Filament.toFixed(2)}`;
    if (tcoElecYearDisplay) tcoElecYearDisplay.textContent = `${curr}${year1Elec.toFixed(2)}`;
    if (tcoBreakEvenParts) tcoBreakEvenParts.textContent = `${breakEvenCount}`;
    if (tcoBreakEvenMonths) tcoBreakEvenMonths.textContent = `~${breakEvenMonths}`;
  }

  printerSelect?.addEventListener('change', () => {
    if (printerSelect.value === 'custom') {
      updateTCO();
      return;
    }
    const selected = printers.find(p => p.slug === printerSelect.value);
    if (selected) {
      hardwarePriceInput.value = selected.msrpUsd.toString();
      printerWattsInput.value = selected.avgWattsPla.toString();
      updateTCO();
    }
  });

  [hardwarePriceInput, printerWattsInput, monthlyHoursInput, spoolsMonthInput, spoolCostInput, elecRateInput, outsourceCostInput].forEach(inp => {
    inp?.addEventListener('input', updateTCO);
  });

  updateTCO();
</script>
