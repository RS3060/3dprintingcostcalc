---
import Layout from '../../layouts/Layout.astro';
import tareData from '../../data/spoolTareWeights.json';
import { getPageTranslations } from '../../i18n/pageTranslations';
import { getTranslations } from '../../i18n/translations';
import { LOCALES, DEFAULT_LOCALE, getLocalizedPath, type LocaleCode } from '../../i18n/locales';

export interface Props {
  locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const currentLocale = (locale as LocaleCode) || DEFAULT_LOCALE;
const t = getTranslations(currentLocale);
const pageT = getPageTranslations(currentLocale).spoolCalc;
---

<Layout
  title={pageT.metaTitle}
  description={pageT.metaDescription}
  keywords={pageT.metaKeywords}
  locale={currentLocale}
  faqList={pageT.faqs}
  breadcrumbs={[
    { name: t.nav.jobCost, item: getLocalizedPath('/', currentLocale) },
    { name: t.nav.spoolTare, item: getLocalizedPath('/spool-remaining-calculator/', currentLocale) }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-950/60 text-cyan-300 border border-cyan-800/40">
        {pageT.badge}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        {pageT.heroTitle} <span class="bg-gradient-to-r from-cyan-400 to-emerald-400 bg-clip-text text-transparent">{pageT.heroGradient}</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {pageT.heroSubtitle}
      </p>
    </div>

    <!-- Interactive Calculator -->
    <div
      id="spoolCalcRoot"
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
    >
      <!-- Input Controls (6 Cols) -->
      <div class="lg:col-span-6 bg-[#0e1628] border border-white/10 rounded-2xl p-6 shadow-xl space-y-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-cyan-400 font-mono">
          {pageT.labels.searchSpool}
        </h2>

        <div class="space-y-4 text-xs">
          <!-- Spool Brand & Model Selector -->
          <div>
            <label for="spoolBrandSelect" class="block font-medium text-slate-300 mb-1">
              {pageT.labels.searchSpool}
            </label>
            <select id="spoolBrandSelect" class="w-full bg-[#162035] border border-white/10 px-3 py-2 text-sm text-white font-medium rounded-lg">
              <option value="custom">{pageT.labels.customTare}</option>
              {tareData.map((s) => (
                <option value={s.id} data-tare={s.emptyWeightGrams}>
                  {s.brand} - {s.spoolType} ({s.emptyWeightGrams}g tare)
                </option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <!-- Gross Scale Weight -->
            <div>
              <label for="grossScaleInput" class="block font-medium text-slate-300 mb-1">
                {pageT.labels.currentWeight}
              </label>
              <input
                type="number"
                id="grossScaleInput"
                step="1"
                min="0"
                value="410"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono"
              />
            </div>

            <!-- Empty Tare Weight -->
            <div>
              <label for="tareWeightInput" class="block font-medium text-slate-300 mb-1">
                {pageT.labels.tareWeight}
              </label>
              <input
                type="number"
                id="tareWeightInput"
                step="1"
                min="0"
                value="212"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono"
              />
            </div>
          </div>

          <!-- Upcoming Print Grams -->
          <div class="pt-2">
            <label for="requiredPrintInput" class="block font-medium text-slate-300 mb-1">
              Upcoming Print (g):
            </label>
            <input
              type="number"
              id="requiredPrintInput"
              step="1"
              min="0"
              value="120"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono"
            />
          </div>
        </div>
      </div>

      <!-- Result Card & Safe Badge (6 Cols) -->
      <div class="lg:col-span-6 bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-cyan-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-cyan-300 font-semibold">{pageT.labels.resultsTitle}</span>
          <div class="flex items-baseline gap-2 mt-2">
            <span class="text-4xl sm:text-5xl font-black text-white font-mono" id="netFilamentDisplay">198g</span>
            <span class="text-sm text-slate-400">{pageT.labels.remainingGrams}</span>
          </div>
          <span class="text-xs text-slate-400 block font-mono mt-1" id="netMetersDisplay">
            ~65.8 m
          </span>
        </div>

        <!-- Safe to Print Badge -->
        <div id="safetyBadge" class="p-4 rounded-xl bg-emerald-950/60 border border-emerald-500/40 text-xs space-y-1.5 transition-all">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="font-bold text-emerald-300 text-sm" id="safetyTitle">OK</span>
          </div>
          <p class="text-slate-300" id="safetyDesc">
            198g &gt; 120g (+78g buffer)
          </p>
        </div>

        <!-- Spool Fill Level Bar -->
        <div class="space-y-1.5">
          <div class="flex justify-between text-xs font-mono text-slate-400">
            <span>{pageT.labels.percentLeft}</span>
            <span id="fullnessPercentage">19.8%</span>
          </div>
          <div class="h-3 w-full bg-slate-800 rounded-full overflow-hidden">
            <div id="fullnessBar" class="h-full bg-gradient-to-r from-cyan-500 to-emerald-400" style="width: 19.8%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Searchable Tare Weight Database Table -->
    <div class="space-y-4 pt-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-tight">{pageT.heroTitle}</h2>
          <p class="text-slate-400 text-xs sm:text-sm">Verified database: Bambu Lab, Polymaker, eSUN, Sunlu, Elegoo, Prusament.</p>
        </div>
        <input
          type="text"
          id="searchTareInput"
          placeholder="Search brand (Bambu, eSUN)..."
          aria-label="Search brand tare weight (Bambu, eSUN, etc.)"
          class="bg-[#0e1628] border border-white/10 rounded-xl px-3 py-2 text-xs text-white font-mono w-full sm:w-64 focus:outline-none focus:ring-2 focus:ring-cyan-500"
        />
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10 bg-[#0e1628]">
        <table class="w-full text-xs text-left" id="tareTable">
          <thead class="bg-white/5 text-slate-400 font-mono border-b border-white/10">
            <tr>
              <th class="py-3 px-4">Brand</th>
              <th class="py-3 px-4">Spool Construction</th>
              <th class="py-3 px-4">Capacity</th>
              <th class="py-3 px-4 text-cyan-400 font-bold">{pageT.labels.tareWeight}</th>
              <th class="py-3 px-4">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono" id="tareTableBody">
            {tareData.map((item) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-3 px-4 font-bold text-white">{item.brand}</td>
                <td class="py-3 px-4 text-slate-300 font-sans">{item.spoolType}</td>
                <td class="py-3 px-4">{item.spoolSizeKg} kg</td>
                <td class="py-3 px-4 text-cyan-400 font-bold text-sm">{item.emptyWeightGrams}g</td>
                <td class="py-3 px-4 text-slate-400 font-sans text-[11px]">{item.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">{t.nav.spoolTare} - FAQ</h2>
      <div class="space-y-3">
        {pageT.faqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-[#0e1628] border border-white/10 transition-all hover:border-cyan-500/30">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-white text-sm sm:text-base gap-4">
              <span class="flex items-center gap-3">
                <span class="text-cyan-400 font-mono text-xs px-2 py-0.5 rounded bg-cyan-950/60 border border-cyan-800/40 shrink-0">Q{index + 1}</span>
                <span class="text-slate-100 group-hover:text-cyan-300 transition-colors">{faq.question}</span>
              </span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-white/5 text-xs sm:text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import tareData from '../../data/spoolTareWeights.json';

  const brandSelect = document.getElementById('spoolBrandSelect') as HTMLSelectElement;
  const grossInput = document.getElementById('grossScaleInput') as HTMLInputElement;
  const tareInput = document.getElementById('tareWeightInput') as HTMLInputElement;
  const reqInput = document.getElementById('requiredPrintInput') as HTMLInputElement;

  const netDisplay = document.getElementById('netFilamentDisplay');
  const metersDisplay = document.getElementById('netMetersDisplay');
  const safetyBadge = document.getElementById('safetyBadge');
  const safetyTitle = document.getElementById('safetyTitle');
  const safetyDesc = document.getElementById('safetyDesc');
  const fullnessPercentage = document.getElementById('fullnessPercentage');
  const fullnessBar = document.getElementById('fullnessBar');

  const searchInput = document.getElementById('searchTareInput') as HTMLInputElement;
  const tableBody = document.getElementById('tareTableBody');

  function calculateNet() {
    if (!grossInput || !tareInput) return;
    const gross = parseFloat(grossInput.value) || 0;
    const tare = parseFloat(tareInput.value) || 0;
    const req = parseFloat(reqInput?.value || '0') || 0;

    const netGrams = Math.max(0, gross - tare);
    const meters = netGrams * 0.3326;
    const pct = Math.min(100, Math.max(0, (netGrams / 1000) * 100));

    if (netDisplay) netDisplay.textContent = `${netGrams.toFixed(0)}g`;
    if (metersDisplay) metersDisplay.textContent = `~${meters.toFixed(1)} m`;

    if (fullnessPercentage) fullnessPercentage.textContent = `${pct.toFixed(1)}%`;
    if (fullnessBar) fullnessBar.style.width = `${pct}%`;

    if (safetyBadge && safetyTitle && safetyDesc) {
      if (netGrams >= req + 15) {
        safetyBadge.className = 'p-4 rounded-xl bg-emerald-950/60 border border-emerald-500/40 text-xs space-y-1.5 transition-all';
        safetyTitle.textContent = `Safe (${netGrams.toFixed(0)}g >= ${req}g)`;
        safetyDesc.textContent = `Buffer: +${(netGrams - req).toFixed(0)}g`;
      } else if (netGrams >= req) {
        safetyBadge.className = 'p-4 rounded-xl bg-amber-950/60 border border-amber-500/40 text-xs space-y-1.5 transition-all';
        safetyTitle.textContent = `Tight buffer (${netGrams.toFixed(0)}g vs ${req}g)`;
        safetyDesc.textContent = `Buffer: +${(netGrams - req).toFixed(0)}g`;
      } else {
        safetyBadge.className = 'p-4 rounded-xl bg-rose-950/60 border border-rose-500/40 text-xs space-y-1.5 transition-all';
        safetyTitle.textContent = `Warning (${netGrams.toFixed(0)}g < ${req}g)`;
        safetyDesc.textContent = `Deficit: -${(req - netGrams).toFixed(0)}g`;
      }
    }
  }

  brandSelect?.addEventListener('change', () => {
    if (brandSelect.value === 'custom') {
      calculateNet();
      return;
    }
    const item = tareData.find(t => t.id === brandSelect.value);
    if (item) {
      tareInput.value = item.emptyWeightGrams.toString();
      calculateNet();
    }
  });

  [grossInput, tareInput, reqInput].forEach(inp => {
    inp?.addEventListener('input', calculateNet);
  });

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    if (!tableBody) return;
    const rows = tableBody.querySelectorAll('tr');
    rows.forEach(r => {
      const text = r.textContent?.toLowerCase() || '';
      r.style.display = text.includes(q) ? '' : 'none';
    });
  });

  calculateNet();
</script>
