---
import Layout from '../../layouts/Layout.astro';
import { getPageTranslations } from '../../i18n/pageTranslations';
import { getTranslations } from '../../i18n/translations';
import { LOCALES, DEFAULT_LOCALE, getLocalizedPath, type LocaleCode } from '../../i18n/locales';

export interface Props {
  locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const currentLocale = (locale as LocaleCode) || DEFAULT_LOCALE;
const locInfo = LOCALES[currentLocale] || LOCALES[DEFAULT_LOCALE];
const t = getTranslations(currentLocale);
const pageT = getPageTranslations(currentLocale).resinCalc;
const curr = locInfo.currency;

const defaultBottlePrice = currentLocale === 'zh' ? 89 : (currentLocale === 'ja' ? 3800 : (currentLocale === 'ko' ? 32000 : (currentLocale === 'pt' ? 149 : (['fr', 'de', 'es', 'it'].includes(currentLocale) ? 29.99 : 26.99))));
---

<Layout
  title={pageT.metaTitle}
  description={pageT.metaDescription}
  keywords={pageT.metaKeywords}
  locale={currentLocale}
  faqList={pageT.faqs}
  breadcrumbs={[
    { name: t.nav.jobCost, item: getLocalizedPath('/', currentLocale) },
    { name: t.nav.resinSla, item: getLocalizedPath('/resin-3d-print-cost-calculator/', currentLocale) }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <div class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-pink-950/60 text-pink-300 border border-pink-800/40">
        {pageT.badge}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        {pageT.heroTitle} <span class="bg-gradient-to-r from-pink-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent">{pageT.heroGradient}</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {pageT.heroSubtitle}
      </p>
    </div>

    <!-- Interactive Calculator -->
    <div
      id="resinRoot"
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
      data-currency={curr}
    >
      <!-- Input Controls (6 Cols) -->
      <div class="lg:col-span-6 bg-[#0e1628] border border-white/10 rounded-2xl p-6 shadow-xl space-y-5">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-pink-400 font-mono">
          {pageT.labels.configTitle}
        </h2>

        <div class="space-y-4 text-xs">
          <!-- Resin Bottle Price & Capacity -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="resinBottlePrice" class="block font-medium text-slate-300 mb-1">{pageT.labels.bottlePrice}</label>
              <input type="number" id="resinBottlePrice" value={defaultBottlePrice} step="1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>
            <div>
              <label for="resinBottleSize" class="block font-medium text-slate-300 mb-1">mL / bottle:</label>
              <input type="number" id="resinBottleSize" value="1000" step="500" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>
          </div>

          <!-- Model Volume & Supports -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="resinModelMl" class="block font-medium text-slate-300 mb-1">{pageT.labels.printMl}</label>
              <input type="number" id="resinModelMl" value="65" step="5" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>
            <div>
              <label for="resinSupportPct" class="block font-medium text-slate-300 mb-1">Supports (%):</label>
              <input type="number" id="resinSupportPct" value="20" step="5" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
            </div>
          </div>

          <!-- Print Time -->
          <div>
            <label for="resinPrintHours" class="block font-medium text-slate-300 mb-1">Exposure Time (h):</label>
            <input type="number" id="resinPrintHours" value="4.5" step="0.5" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono" />
          </div>

          <!-- Chemical & Consumables Overhead -->
          <div class="pt-2 border-t border-white/5 space-y-3">
            <h3 class="font-bold text-white text-xs">{pageT.labels.consumablesCost}</h3>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="resinIpaCost" class="block text-slate-400 mb-1">{pageT.labels.ipaCost}</label>
                <input type="number" id="resinIpaCost" value="0.75" step="0.1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-white font-mono text-sm" />
              </div>
              <div>
                <label for="resinFepCost" class="block text-slate-400 mb-1">{pageT.labels.screenDeprec}</label>
                <input type="number" id="resinFepCost" value="0.60" step="0.1" class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-white font-mono text-sm" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Result Card (6 Cols) -->
      <div class="lg:col-span-6 bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-pink-500/30 rounded-2xl p-6 shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-pink-300 font-semibold">{pageT.labels.resultsTitle}</span>
          <div class="flex items-baseline gap-2 mt-2">
            <span class="text-4xl sm:text-5xl font-black text-white font-mono" id="resinTotalCostDisplay">{curr}3.46</span>
            <span class="text-sm text-slate-400">{pageT.labels.totalJobCost}</span>
          </div>
          <span class="text-xs text-slate-400 block font-mono mt-1" id="resinUnitCostDisplay">
            78.0 mL
          </span>
        </div>

        <!-- Breakdown List -->
        <div class="border-t border-white/10 pt-4 space-y-2.5 text-xs font-mono">
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{pageT.labels.rawResinCost}:</span>
            <span id="resinModelCostDisplay" class="font-bold text-white">{curr}1.75</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{pageT.labels.ipaCost}:</span>
            <span id="resinIpaDisplay" class="font-bold text-white">{curr}0.75</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{pageT.labels.screenDeprec}:</span>
            <span id="resinFepDisplay" class="font-bold text-white">{curr}0.60</span>
          </div>
        </div>

        <!-- Suggested Client Price -->
        <div class="p-4 rounded-xl bg-pink-950/40 border border-pink-500/30 space-y-1">
          <div class="flex justify-between items-center">
            <span class="font-bold text-pink-300 text-xs">{t.calc.retailMargin}:</span>
            <span class="text-emerald-400 font-mono text-xs font-semibold">3.0x</span>
          </div>
          <div class="text-2xl font-black text-white font-mono" id="resinClientPrice">{curr}10.38</div>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="text-2xl font-bold text-white tracking-tight">{t.nav.resinSla} - FAQ</h2>
      <div class="space-y-3">
        {pageT.faqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-[#0e1628] border border-white/10 transition-all hover:border-purple-500/30">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-white text-sm sm:text-base gap-4">
              <span class="flex items-center gap-3">
                <span class="text-purple-400 font-mono text-xs px-2 py-0.5 rounded bg-purple-950/60 border border-purple-800/40 shrink-0">Q{index + 1}</span>
                <span class="text-slate-100 group-hover:text-purple-300 transition-colors">{faq.question}</span>
              </span>
              <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="mt-3 pt-3 border-t border-white/5 text-xs sm:text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  const root = document.getElementById('resinRoot');
  const curr = root?.dataset.currency || '$';

  const priceInput = document.getElementById('resinBottlePrice') as HTMLInputElement;
  const sizeInput = document.getElementById('resinBottleSize') as HTMLInputElement;
  const modelInput = document.getElementById('resinModelMl') as HTMLInputElement;
  const supportInput = document.getElementById('resinSupportPct') as HTMLInputElement;
  const hoursInput = document.getElementById('resinPrintHours') as HTMLInputElement;
  const ipaInput = document.getElementById('resinIpaCost') as HTMLInputElement;
  const fepInput = document.getElementById('resinFepCost') as HTMLInputElement;

  const totalCostDisplay = document.getElementById('resinTotalCostDisplay');
  const unitCostDisplay = document.getElementById('resinUnitCostDisplay');
  const modelCostDisplay = document.getElementById('resinModelCostDisplay');
  const ipaDisplay = document.getElementById('resinIpaDisplay');
  const fepDisplay = document.getElementById('resinFepDisplay');
  const clientPrice = document.getElementById('resinClientPrice');

  function calculateResin() {
    if (!priceInput || !sizeInput) return;
    const bottlePrice = parseFloat(priceInput.value) || 27;
    const bottleSize = Math.max(1, parseFloat(sizeInput.value) || 1000);
    const modelMl = parseFloat(modelInput?.value || '0') || 0;
    const supportPct = (parseFloat(supportInput?.value || '0') || 0) / 100;
    const hours = parseFloat(hoursInput?.value || '0') || 0;
    const ipaCost = parseFloat(ipaInput?.value || '0') || 0;
    const fepCost = parseFloat(fepInput?.value || '0') || 0;

    const costPerMl = bottlePrice / bottleSize;
    const supportMl = modelMl * supportPct;
    const totalMl = modelMl + supportMl;

    const modelCost = modelMl * costPerMl;
    const supportCost = supportMl * costPerMl;
    const elecCost = (55 / 1000) * hours * 0.20;

    const totalLanded = modelCost + supportCost + ipaCost + fepCost + elecCost;
    const recommendedPrice = totalLanded * 3.0;

    if (totalCostDisplay) totalCostDisplay.textContent = `${curr}${totalLanded.toFixed(2)}`;
    if (unitCostDisplay) unitCostDisplay.textContent = `${totalMl.toFixed(1)} mL (${curr}${costPerMl.toFixed(4)}/mL)`;
    if (modelCostDisplay) modelCostDisplay.textContent = `${curr}${modelCost.toFixed(2)}`;
    if (ipaDisplay) ipaDisplay.textContent = `${curr}${ipaCost.toFixed(2)}`;
    if (fepDisplay) fepDisplay.textContent = `${curr}${fepCost.toFixed(2)}`;
    if (clientPrice) clientPrice.textContent = `${curr}${recommendedPrice.toFixed(2)}`;
  }

  [priceInput, sizeInput, modelInput, supportInput, hoursInput, ipaInput, fepInput].forEach(inp => {
    inp?.addEventListener('input', calculateResin);
  });

  calculateResin();
</script>
