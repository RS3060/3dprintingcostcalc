---
import Layout from '../../layouts/Layout.astro';
import { getPageTranslations } from '../../i18n/pageTranslations';
import { getTranslations } from '../../i18n/translations';
import { LOCALES, DEFAULT_LOCALE, getLocalizedPath, type LocaleCode } from '../../i18n/locales';

export interface Props {
  locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const currentLocale = (locale as LocaleCode) || DEFAULT_LOCALE;
const t = getTranslations(currentLocale);
const legal = getPageTranslations(currentLocale).legal;
---

<Layout
  title={`${legal.privacyTitle} | 3DPrintingCostCalc.com`}
  description={legal.privacyDesc}
  locale={currentLocale}
  breadcrumbs={[
    { name: t.nav.jobCost, item: getLocalizedPath('/', currentLocale) },
    { name: legal.privacyTitle, item: getLocalizedPath('/privacy/', currentLocale) }
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8 text-slate-300">
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{legal.privacyTitle}</h1>
      <p class="text-xs text-slate-400 font-mono">{legal.privacyBadge}</p>
    </div>

    <!-- Highlight Box -->
    <div class="p-5 rounded-2xl bg-cyan-950/40 border border-cyan-500/30 text-xs sm:text-sm text-cyan-200 leading-relaxed">
      <strong>{legal.privacyGuarTitle}:</strong> {legal.privacyGuarDesc}
    </div>

    <!-- 1. Zero-Upload Architecture -->
    <section class="space-y-3 text-xs sm:text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">{legal.sec1Title}</h2>
      <p>
        {legal.sec1Desc}
      </p>
    </section>

    <!-- 2. Information We Do Not Collect -->
    <section class="space-y-3 text-xs sm:text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">{legal.sec2Title}</h2>
      <p>
        {legal.sec2Desc}
      </p>
    </section>

    <!-- 3. Local Storage & Client-Side Configuration -->
    <section class="space-y-3 text-xs sm:text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">{legal.sec3Title}</h2>
      <p>
        {legal.sec3Desc}
      </p>
    </section>
  </div>
</Layout>
