---
import Layout from '../../layouts/Layout.astro';
import { getPageTranslations } from '../../i18n/pageTranslations';
import { getTranslations } from '../../i18n/translations';
import { LOCALES, DEFAULT_LOCALE, getLocalizedPath, type LocaleCode } from '../../i18n/locales';

export interface Props {
  locale?: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const currentLocale = (locale as LocaleCode) || DEFAULT_LOCALE;
const t = getTranslations(currentLocale);
const legal = getPageTranslations(currentLocale).legal;
---

<Layout
  title={`${legal.termsTitle} | 3DPrintingCostCalc.com`}
  description={legal.termsDesc}
  locale={currentLocale}
  breadcrumbs={[
    { name: t.nav.jobCost, item: getLocalizedPath('/', currentLocale) },
    { name: legal.termsTitle, item: getLocalizedPath('/terms/', currentLocale) }
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8 text-slate-300">
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{legal.termsTitle}</h1>
      <p class="text-xs text-slate-400 font-mono">{legal.termsBadge}</p>
    </div>

    <!-- Highlight Box -->
    <div class="p-5 rounded-2xl bg-cyan-950/40 border border-cyan-500/30 text-xs sm:text-sm text-cyan-200 leading-relaxed">
      <strong>{legal.termsSummaryTitle}:</strong> {legal.termsSummaryDesc}
    </div>

    <!-- 1. Acceptance of Terms -->
    <section class="space-y-3 text-xs sm:text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">{legal.termsSec1Title}</h2>
      <p>
        {legal.termsSec1Desc}
      </p>
    </section>

    <!-- 2. Technical Calculation Disclaimer -->
    <section class="space-y-3 text-xs sm:text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">{legal.termsSec2Title}</h2>
      <p>
        {legal.termsSec2Desc}
      </p>
    </section>

    <!-- 3. Commercial & Business Usage -->
    <section class="space-y-3 text-xs sm:text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">{legal.termsSec3Title}</h2>
      <p>
        {legal.termsSec3Desc}
      </p>
    </section>
  </div>
</Layout>
