        <!-- Offsite Ads Toggle for Etsy -->
        <div class="flex items-center justify-between text-xs text-slate-300 pt-1">
          <label for="etsyAdsCheckbox" class="cursor-pointer flex items-center gap-2">
            <input type="checkbox" id="etsyAdsCheckbox" class="rounded bg-slate-800 border-white/20 text-cyan-500 focus:ring-cyan-400" />
            <span>{t.calc.offsiteAds}</span>
          </label>
        </div>

        <!-- Platform Comparison Grid -->
        <div class="grid grid-cols-2 gap-3 text-xs">
          <!-- Direct Invoice -->
          <div class="p-3 rounded-xl bg-[#162035] border border-white/5 space-y-1">
            <span class="font-semibold text-slate-200 block">{t.calc.directLocal}</span>
            <div class="text-lg font-mono font-bold text-white" id="directPriceVal">{currSym}19.63</div>
            <div class="text-[11px] text-emerald-400 font-mono" id="directProfitVal">+{currSym}11.78 {t.calc.profit}</div>
            <span class="text-[10px] text-slate-400 block">{t.calc.feeDeduction}</span>
          </div>

          <!-- Etsy -->
          <div class="p-3 rounded-xl bg-[#162035] border border-white/5 space-y-1">
            <span class="font-semibold text-orange-400 block">{t.calc.etsyStore}</span>
            <div class="text-lg font-mono font-bold text-white" id="etsyPriceVal">{currSym}22.18</div>
            <div class="text-[11px] text-emerald-400 font-mono" id="etsyProfitVal">+{currSym}11.78 {t.calc.profit}</div>
            <span class="text-[10px] text-slate-400 block" id="etsyFeeVal">~{currSym}2.55 Etsy</span>
          </div>

          <!-- eBay -->
          <div class="p-3 rounded-xl bg-[#162035] border border-white/5 space-y-1">
            <span class="font-semibold text-blue-400 block">{t.calc.ebayStore}</span>
            <div class="text-lg font-mono font-bold text-white" id="ebayPriceVal">{currSym}23.09</div>
            <div class="text-[11px] text-emerald-400 font-mono" id="ebayProfitVal">+{currSym}11.78 {t.calc.profit}</div>
            <span class="text-[10px] text-slate-400 block" id="ebayFeeVal">~{currSym}3.46 Fee</span>
          </div>

          <!-- Shopify -->
          <div class="p-3 rounded-xl bg-[#162035] border border-white/5 space-y-1">
            <span class="font-semibold text-emerald-400 block">{t.calc.shopifyWeb}</span>
            <div class="text-lg font-mono font-bold text-white" id="shopifyPriceVal">{currSym}20.52</div>
            <div class="text-[11px] text-emerald-400 font-mono" id="shopifyProfitVal">+{currSym}11.78 {t.calc.profit}</div>
            <span class="text-[10px] text-slate-400 block" id="shopifyFeeVal">~{currSym}0.89 Fee</span>
          </div>
        </div>

        <!-- Action Buttons: Share & PDF Quote -->
        <div class="pt-2 flex flex-col sm:flex-row gap-2">
          <button
            type="button"
            id="shareQuoteBtn"
            class="flex-1 py-2.5 px-3 rounded-xl bg-cyan-700 hover:bg-cyan-600 text-white font-bold text-xs tracking-wide flex items-center justify-center gap-1.5 transition-colors shadow-lg shadow-cyan-900/30 cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
              <polyline points="16 6 12 2 8 6"/>
              <line x1="12" x2="12" y1="2" y2="15"/>
            </svg>
            <span>{t.calc.copyQuote}</span>
          </button>

          <button
            type="button"
            id="printQuoteBtn"
            class="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium text-xs tracking-wide flex items-center justify-center gap-1.5 transition-colors border border-white/10 cursor-pointer"
          >
            <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 6 2 18 2 18 9"/>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
              <rect width="12" height="8" x="6" y="14"/>
            </svg>
            <span>{t.calc.printPdf}</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Share Toast Alert -->
  <div id="shareToast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-cyan-500 text-black px-4 py-2.5 rounded-xl font-medium text-xs shadow-2xl flex items-center gap-2">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    <span>{t.calc.copiedToast}</span>
  </div>

  <!-- Printable Client Invoice Modal / Print Template -->
  <div id="quoteInvoiceModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm p-4 overflow-y-auto">
    <div id="printableInvoiceCard" class="max-w-2xl mx-auto bg-white text-slate-900 rounded-2xl p-8 shadow-2xl my-8 relative">
      <button id="closeInvoiceBtn" class="absolute top-4 right-4 p-2 text-slate-400 hover:text-slate-800 no-print cursor-pointer">
        ✕
      </button>

      <!-- Invoice Header -->
      <div class="border-b border-slate-200 pb-6 mb-6 flex justify-between items-start">
        <div>
          <h2 class="text-2xl font-black tracking-tight text-slate-900">{t.calc.invoiceTitle}</h2>
          <p class="text-xs text-slate-500 font-mono mt-1">{t.calc.invoiceSubtitle}</p>
        </div>
        <div class="text-right text-xs text-slate-500 font-mono">
          <p>{t.calc.invoiceDate} <span id="invoiceDate"></span></p>
          <p>{t.calc.invoiceRef} <span id="invoiceRef">#3DP-9481</span></p>
          <p>{t.calc.invoiceValid}</p>
        </div>
      </div>

      <!-- Item Specifications Table -->
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-xs border-collapse min-w-[420px]">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 text-left">
              <th class="py-2">{t.calc.invoiceDesc}</th>
              <th class="py-2">{t.calc.invoiceMat}</th>
              <th class="py-2">{t.calc.invoiceWeight}</th>
              <th class="py-2">{t.calc.invoiceTime}</th>
              <th class="py-2 text-right">{t.calc.invoicePrice}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-mono">
            <tr>
              <td class="py-3 font-semibold text-slate-800" id="invoiceModelName">{t.calc.invoiceItemName}</td>
              <td class="py-3 text-slate-600" id="invoiceMaterialName">PLA</td>
              <td class="py-3 text-slate-600" id="invoiceWeight">85g</td>
              <td class="py-3 text-slate-600" id="invoiceTime">3.5 hrs</td>
              <td class="py-3 text-right font-bold text-slate-900 text-sm" id="invoicePrice">{currSym}19.63</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Notes & Terms -->
      <div class="border-t border-slate-200 pt-4 text-[11px] text-slate-500 space-y-1">
        <p><strong>{t.calc.invoiceTerms}</strong></p>
        <p>{t.calc.invoiceNote}</p>
      </div>

      <!-- Print Action inside modal -->
      <div class="mt-8 pt-4 border-t border-slate-100 flex justify-end gap-3 no-print">
        <button id="triggerPrintBtn" class="px-5 py-2.5 rounded-xl bg-slate-900 text-white font-medium text-xs hover:bg-slate-800 transition-colors shadow-sm cursor-pointer">
          {t.calc.invoicePrintBtn}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculate3DPrintCost } from '../utils/costMath';
  import { parse3DFile, estimateMeshWeightAndTime } from '../utils/fileParser';
  import printers from '../data/printers.json';
  import materials from '../data/materials.json';

  // Elements
  const root = document.getElementById('calculatorRoot');
  const currencySym = root?.dataset.currency || '$';
  const profitLabel = root?.dataset.profitLabel || 'profit';
  const defaultItemName = root?.dataset.invoiceItemName || 'Custom 3D Print Job';

  const printerSelect = document.getElementById('printerSelect') as HTMLSelectElement;
  const materialSelect = document.getElementById('materialSelect') as HTMLSelectElement;
  const printerSummary = document.getElementById('printerPresetSummary');

  // Explicit user insertion inputs for hardware and material
  const printerWattsInput = document.getElementById('printerWattsInput') as HTMLInputElement;
  const materialDensityInput = document.getElementById('materialDensityInput') as HTMLInputElement;

  // Primary Inputs
  const spoolPriceInput = document.getElementById('spoolPriceInput') as HTMLInputElement;
  const spoolWeightInput = document.getElementById('spoolWeightInput') as HTMLInputElement;
  const printWeightInput = document.getElementById('printWeightInput') as HTMLInputElement;
  const purgeWasteInput = document.getElementById('purgeWasteInput') as HTMLInputElement;
  const printHoursInput = document.getElementById('printHoursInput') as HTMLInputElement;
  const electricityRateInput = document.getElementById('electricityRateInput') as HTMLInputElement;

  // Advanced Inputs
  const printerPriceInput = document.getElementById('printerPriceInput') as HTMLInputElement;
  const lifespanInput = document.getElementById('lifespanInput') as HTMLInputElement;
  const maintenanceInput = document.getElementById('maintenanceInput') as HTMLInputElement;
  const failureRateInput = document.getElementById('failureRateInput') as HTMLInputElement;
  const laborMinutesInput = document.getElementById('laborMinutesInput') as HTMLInputElement;
  const laborRateInput = document.getElementById('laborRateInput') as HTMLInputElement;
  const hardwareCostInput = document.getElementById('hardwareCostInput') as HTMLInputElement;
  const packagingCostInput = document.getElementById('packagingCostInput') as HTMLInputElement;

  // Commercial Sliders
  const markupSlider = document.getElementById('markupSlider') as HTMLInputElement;
  const etsyAdsCheckbox = document.getElementById('etsyAdsCheckbox') as HTMLInputElement;
  const multiplierLabel = document.getElementById('multiplierLabel');
  const targetMarginLabel = document.getElementById('targetMarginLabel');

  // Displays
  const totalLandedCostDisplay = document.getElementById('totalLandedCostDisplay');
  const costPerGramBadge = document.getElementById('costPerGramBadge');
  const costMaterialDisplay = document.getElementById('costMaterialDisplay');
  const costElectricityDisplay = document.getElementById('costElectricityDisplay');
  const costMachineDisplay = document.getElementById('costMachineDisplay');
  const costFailureDisplay = document.getElementById('costFailureDisplay');
  const costLaborDisplay = document.getElementById('costLaborDisplay');
  const printWeightGramLive = document.getElementById('printWeightGramLive');
  const printTimeLive = document.getElementById('printTimeLive');

  // Bars
  const barMaterial = document.getElementById('barMaterial');
  const barElec = document.getElementById('barElec');
  const barMachine = document.getElementById('barMachine');
  const barLabor = document.getElementById('barLabor');
  const barOther = document.getElementById('barOther');

  // Platforms
  const directPriceVal = document.getElementById('directPriceVal');
  const directProfitVal = document.getElementById('directProfitVal');
  const etsyPriceVal = document.getElementById('etsyPriceVal');
  const etsyProfitVal = document.getElementById('etsyProfitVal');
  const etsyFeeVal = document.getElementById('etsyFeeVal');
  const ebayPriceVal = document.getElementById('ebayPriceVal');
  const ebayProfitVal = document.getElementById('ebayProfitVal');
  const ebayFeeVal = document.getElementById('ebayFeeVal');
  const shopifyPriceVal = document.getElementById('shopifyPriceVal');
  const shopifyProfitVal = document.getElementById('shopifyProfitVal');
  const shopifyFeeVal = document.getElementById('shopifyFeeVal');

  // Advanced accordion
  const advancedToggleBtn = document.getElementById('advancedToggleBtn');
  const advancedContent = document.getElementById('advancedContent');
  const advancedArrow = document.getElementById('advancedArrow');

  // File Drop Elements
  const dropZone = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const fileInfoCard = document.getElementById('fileInfoCard');
  const parsedFileName = document.getElementById('parsedFileName');
  const parsedFileTypeBadge = document.getElementById('parsedFileTypeBadge');
  const parsedFileSize = document.getElementById('parsedFileSize');
  const parsedFilamentGrams = document.getElementById('parsedFilamentGrams');
  const parsedPrintTime = document.getElementById('parsedPrintTime');
  const parsedMeshVol = document.getElementById('parsedMeshVol');
  const parsedNote = document.getElementById('parsedNote');
  const meshAdjustControls = document.getElementById('meshAdjustControls');
  const wallLoopsInput = document.getElementById('wallLoopsInput') as HTMLInputElement;
  const wallLoopsVal = document.getElementById('wallLoopsVal');
  const infillInput = document.getElementById('infillInput') as HTMLInputElement;
  const infillVal = document.getElementById('infillVal');
  const supportSelect = document.getElementById('supportSelect') as HTMLSelectElement;

  // Share & PDF Elements
  const shareQuoteBtn = document.getElementById('shareQuoteBtn');
  const shareToast = document.getElementById('shareToast');
  const printQuoteBtn = document.getElementById('printQuoteBtn');
  const quoteInvoiceModal = document.getElementById('quoteInvoiceModal');
  const closeInvoiceBtn = document.getElementById('closeInvoiceBtn');
  const triggerPrintBtn = document.getElementById('triggerPrintBtn');
  const invoiceDate = document.getElementById('invoiceDate');
  const invoiceRef = document.getElementById('invoiceRef');
  const invoiceModelName = document.getElementById('invoiceModelName');
  const invoiceMaterialName = document.getElementById('invoiceMaterialName');
  const invoiceWeight = document.getElementById('invoiceWeight');
  const invoiceTime = document.getElementById('invoiceTime');
  const invoicePrice = document.getElementById('invoicePrice');

  let currentMeshVolume = 0;
  let currentSurfaceArea = 0;
  let currentActiveFile: File | null = null;

  // Spool weight quick buttons
  document.querySelectorAll('.spool-preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const weight = (e.currentTarget as HTMLElement).dataset.weight;
      if (weight) {
        spoolWeightInput.value = weight;
        updateCalculations();
      }
    });
  });

  // Get active printer & material objects
  function getActivePrinter() {
    const slug = printerSelect.value;
    if (slug === 'custom') {
      return {
        slug: 'custom',
        brand: 'Custom',
        model: 'Manual 3D Printer',
        avgWattsPla: parseFloat(printerWattsInput.value) || 120,
        msrpUsd: parseFloat(printerPriceInput.value) || 500,
        defaultLifespanHours: parseFloat(lifespanInput.value) || 4000,
        hourlyMaintenanceUsd: parseFloat(maintenanceInput.value) || 0.08,
        effectiveFlowMm3s: 10.0,
      };
    }
    return printers.find(p => p.slug === slug) || printers[0];
  }

  function getActiveMaterial() {
    const slug = materialSelect.value;
    if (slug === 'custom') {
      return {
        slug: 'custom',
        name: 'Custom Material',
        densityGcm3: parseFloat(materialDensityInput.value) || 1.24,
        defaultPricePerKgUsd: parseFloat(spoolPriceInput.value) || 20,
        powerMultiplier: 1.0,
      };
    }
    return materials.find(m => m.slug === slug) || materials[0];
  }

  // Recalculate
  function updateCalculations() {
    const activePrinter = getActivePrinter();
    const activeMaterial = getActiveMaterial();

    const spoolPriceUsd = parseFloat(spoolPriceInput.value) || 0;
    const spoolWeightGrams = parseFloat(spoolWeightInput.value) || 1000;
    const printWeightGrams = parseFloat(printWeightInput.value) || 0;
    const purgeWasteGrams = parseFloat(purgeWasteInput.value) || 0;
    const printTimeHours = parseFloat(printHoursInput.value) || 0;
    const electricityRateKwh = parseFloat(electricityRateInput.value) || 0.16;

    const powerWatts = parseFloat(printerWattsInput.value) || activePrinter.avgWattsPla;
    const printerPriceUsd = parseFloat(printerPriceInput.value) || activePrinter.msrpUsd;
    const expectedLifespanHours = parseFloat(lifespanInput.value) || activePrinter.defaultLifespanHours;
    const hourlyMaintenanceUsd = parseFloat(maintenanceInput.value) || activePrinter.hourlyMaintenanceUsd;
    const failureRatePercent = parseFloat(failureRateInput.value) || 0;
    const postProcessingMinutes = parseFloat(laborMinutesInput.value) || 0;
    const hourlyLaborRateUsd = parseFloat(laborRateInput.value) || 0;
    const hardwareCostUsd = parseFloat(hardwareCostInput.value) || 0;
    const packagingCostUsd = parseFloat(packagingCostInput.value) || 0;
    const markupMultiplier = parseFloat(markupSlider.value) || 2.5;
    const etsyOffsiteAds = etsyAdsCheckbox.checked;

    const results = calculate3DPrintCost({
      spoolPriceUsd,
      spoolWeightGrams,
      printWeightGrams,
      purgeWasteGrams,
      printTimeHours,
      printerPowerWatts: powerWatts,
      electricityRateKwh,
      printerPriceUsd,
      expectedLifespanHours,
      hourlyMaintenanceUsd,
      failureRatePercent,
      postProcessingMinutes,
      hourlyLaborRateUsd,
      hardwareCostUsd,
      packagingCostUsd,
      markupMultiplier,
      etsyOffsiteAds,
    });

    // Update Live UI with localized currency symbol
    if (totalLandedCostDisplay) totalLandedCostDisplay.textContent = `${currencySym}${results.totalLandedCost.toFixed(2)}`;
    if (costPerGramBadge) costPerGramBadge.textContent = `${currencySym}${results.costPerGram.toFixed(4)}/g`;
    if (costMaterialDisplay) costMaterialDisplay.textContent = `${currencySym}${results.materialCost.toFixed(2)}`;
    if (costElectricityDisplay) costElectricityDisplay.textContent = `${currencySym}${results.electricityCost.toFixed(2)}`;
    if (costMachineDisplay) costMachineDisplay.textContent = `${currencySym}${results.machineWearCost.toFixed(2)}`;
    if (costFailureDisplay) costFailureDisplay.textContent = `${currencySym}${results.failureBufferCost.toFixed(2)}`;
    if (costLaborDisplay) costLaborDisplay.textContent = `${currencySym}${(results.laborCost + results.hardwareCost + results.packagingCost).toFixed(2)}`;

    if (printWeightGramLive) printWeightGramLive.textContent = `${results.totalFilamentGrams}g`;
    if (printTimeLive) printTimeLive.textContent = `${printTimeHours} hrs`;

    // Multiplier Labels
    if (multiplierLabel) multiplierLabel.textContent = `${markupMultiplier.toFixed(1)}x`;
    if (targetMarginLabel) targetMarginLabel.textContent = `${results.directMarginPercent}%`;

    // Visual Waterfall Bar
    if (barMaterial) barMaterial.style.width = `${results.percentages.material}%`;
    if (barElec) barElec.style.width = `${results.percentages.electricity}%`;
    if (barMachine) barMachine.style.width = `${results.percentages.machine}%`;
    if (barLabor) barLabor.style.width = `${results.percentages.labor}%`;
    if (barOther) barOther.style.width = `${results.percentages.other + results.percentages.failure}%`;

    // Platform Breakdown
    if (directPriceVal) directPriceVal.textContent = `${currencySym}${results.platforms.direct.recommendedPrice.toFixed(2)}`;
    if (directProfitVal) directProfitVal.textContent = `+${currencySym}${results.platforms.direct.netProfit.toFixed(2)} ${profitLabel}`;

    if (etsyPriceVal) etsyPriceVal.textContent = `${currencySym}${results.platforms.etsy.recommendedPrice.toFixed(2)}`;
    if (etsyProfitVal) etsyProfitVal.textContent = `+${currencySym}${results.platforms.etsy.netProfit.toFixed(2)} ${profitLabel}`;
    if (etsyFeeVal) etsyFeeVal.textContent = `~${currencySym}${results.platforms.etsy.platformFees.toFixed(2)} Etsy`;

    if (ebayPriceVal) ebayPriceVal.textContent = `${currencySym}${results.platforms.ebay.recommendedPrice.toFixed(2)}`;
    if (ebayProfitVal) ebayProfitVal.textContent = `+${currencySym}${results.platforms.ebay.netProfit.toFixed(2)} ${profitLabel}`;
    if (ebayFeeVal) ebayFeeVal.textContent = `~${currencySym}${results.platforms.ebay.platformFees.toFixed(2)} Fee`;

    if (shopifyPriceVal) shopifyPriceVal.textContent = `${currencySym}${results.platforms.shopify.recommendedPrice.toFixed(2)}`;
    if (shopifyProfitVal) shopifyProfitVal.textContent = `+${currencySym}${results.platforms.shopify.netProfit.toFixed(2)} ${profitLabel}`;
    if (shopifyFeeVal) shopifyFeeVal.textContent = `~${currencySym}${results.platforms.shopify.platformFees.toFixed(2)} Fee`;

    // Update Invoice Preview Fields
    if (invoiceModelName) invoiceModelName.textContent = currentActiveFile ? currentActiveFile.name : defaultItemName;
    if (invoiceMaterialName) invoiceMaterialName.textContent = activeMaterial.name;
    if (invoiceWeight) invoiceWeight.textContent = `${results.totalFilamentGrams}g`;
    if (invoiceTime) invoiceTime.textContent = `${printTimeHours} hrs`;
    if (invoicePrice) invoicePrice.textContent = `${currencySym}${results.platforms.direct.recommendedPrice.toFixed(2)}`;
  }

  // Handle printer selection change
  printerSelect?.addEventListener('change', () => {
    if (printerSelect.value === 'custom') {
      return;
    }
    const printer = getActivePrinter();
    if (printerSummary) {
      printerSummary.textContent = `Watts: ${printer.avgWattsPla}W · MSRP: ${currencySym}${printer.msrpUsd} · Lifespan: ${printer.defaultLifespanHours}h`;
    }
    printerWattsInput.value = printer.avgWattsPla.toString();
    printerPriceInput.value = printer.msrpUsd.toString();
    lifespanInput.value = printer.defaultLifespanHours.toString();
    maintenanceInput.value = printer.hourlyMaintenanceUsd.toString();
    updateCalculations();
  });

  // Handle manual input of printer wattage
  printerWattsInput?.addEventListener('input', () => {
    if (printerSelect.value !== 'custom') {
      const selected = getActivePrinter();
      if (parseFloat(printerWattsInput.value) !== selected.avgWattsPla) {
        printerSelect.value = 'custom';
      }
    }
    updateCalculations();
  });

  // Handle material selection change
  materialSelect?.addEventListener('change', () => {
    if (materialSelect.value === 'custom') {
      return;
    }
    const mat = getActiveMaterial();
    materialDensityInput.value = mat.densityGcm3.toString();
    spoolPriceInput.value = mat.defaultPricePerKgUsd.toString();

    if (currentMeshVolume > 0) {
      recomputeMeshEstimation();
    } else {
      updateCalculations();
    }
  });

  // Handle manual density input
  materialDensityInput?.addEventListener('input', () => {
    if (materialSelect.value !== 'custom') {
      const selected = getActiveMaterial();
      if (parseFloat(materialDensityInput.value) !== selected.densityGcm3) {
        materialSelect.value = 'custom';
      }
    }
    if (currentMeshVolume > 0) {
      recomputeMeshEstimation();
    } else {
      updateCalculations();
    }
  });

  // Recompute mesh estimation from sliders
  function recomputeMeshEstimation() {
    const activePrinter = getActivePrinter();
    const density = parseFloat(materialDensityInput.value) || 1.24;

    const wallLoops = parseInt(wallLoopsInput.value, 10) || 2;
    const infillRatio = (parseInt(infillInput.value, 10) || 15) / 100.0;
    const supportMultiplier = parseFloat(supportSelect.value) || 1.0;

    const estimated = estimateMeshWeightAndTime(currentMeshVolume, currentSurfaceArea, {
      wallLoops,
      infillRatio,
      materialDensity: density,
      supportMultiplier,
      volumetricFlowMm3s: activePrinter.effectiveFlowMm3s || 10.0,
    });

    printWeightInput.value = estimated.filamentGrams.toString();
    printHoursInput.value = estimated.printTimeHours.toString();

    if (parsedFilamentGrams) parsedFilamentGrams.textContent = `${estimated.filamentGrams}g`;
    if (parsedPrintTime) parsedPrintTime.textContent = `${estimated.printTimeHours} hrs`;

    updateCalculations();
  }

  // Sliders for unsliced meshes
  wallLoopsInput?.addEventListener('input', () => {
    if (wallLoopsVal) wallLoopsVal.textContent = wallLoopsInput.value;
    recomputeMeshEstimation();
  });

  infillInput?.addEventListener('input', () => {
    if (infillVal) infillVal.textContent = `${infillInput.value}%`;
    recomputeMeshEstimation();
  });

  supportSelect?.addEventListener('change', () => {
    recomputeMeshEstimation();
  });

  // File Drop Handling
  async function handleDroppedFile(file: File) {
    currentActiveFile = file;
    const density = parseFloat(materialDensityInput.value) || 1.24;
    const activePrinter = getActivePrinter();

    if (fileInfoCard) fileInfoCard.classList.remove('hidden');
    if (parsedFileName) parsedFileName.textContent = file.name;
    if (parsedFileSize) parsedFileSize.textContent = `${(file.size / 1024).toFixed(1)} KB`;

    try {
      const parsed = await parse3DFile(file, {
        wallLoops: parseInt(wallLoopsInput.value, 10) || 2,
        infillRatio: (parseInt(infillInput.value, 10) || 15) / 100,
        materialDensity: density,
        supportMultiplier: parseFloat(supportSelect.value) || 1.0,
        volumetricFlowMm3s: activePrinter.effectiveFlowMm3s || 10.0,
      });

      if (parsedFileTypeBadge) parsedFileTypeBadge.textContent = parsed.fileType.toUpperCase();
      if (parsedFilamentGrams) parsedFilamentGrams.textContent = `${parsed.filamentGrams}g`;
      if (parsedPrintTime) parsedPrintTime.textContent = `${parsed.printTimeHours} hrs`;
      if (parsedMeshVol) parsedMeshVol.textContent = parsed.volumeCm3 ? `${parsed.volumeCm3} cm³` : 'N/A';

      printWeightInput.value = parsed.filamentGrams.toString();
      printHoursInput.value = parsed.printTimeHours.toString();

      if (parsed.isSliced) {
        if (meshAdjustControls) meshAdjustControls.classList.add('hidden');
        if (parsedNote) {
          parsedNote.textContent = parsed.slicerName
            ? `Extracted from ${parsed.slicerName}.`
            : `Exact slicer metadata extracted directly from file headers.`;
        }
        currentMeshVolume = 0;
        currentSurfaceArea = 0;
      } else {
        currentMeshVolume = parsed.volumeCm3 || 0;
        currentSurfaceArea = parsed.surfaceAreaCm2 || 0;
        if (meshAdjustControls) meshAdjustControls.classList.remove('hidden');
      }

      updateCalculations();
    } catch (err: any) {
      alert(`File analysis error: ${err.message || 'Unable to parse file'}`);
    }
  }

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-cyan-400', 'bg-cyan-500/10');
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-cyan-400', 'bg-cyan-500/10');
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-cyan-400', 'bg-cyan-500/10');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      handleDroppedFile(e.dataTransfer.files[0]);
    }
  });

  dropZone?.addEventListener('click', () => {
    fileInput?.click();
  });

  dropZone?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput?.click();
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      handleDroppedFile(fileInput.files[0]);
    }
  });

  // Advanced accordion toggle
  advancedToggleBtn?.addEventListener('click', () => {
    advancedContent?.classList.toggle('hidden');
    advancedArrow?.classList.toggle('rotate-180');
  });

  // Event listeners for recalculating
  [
    spoolPriceInput,
    spoolWeightInput,
    printWeightInput,
    purgeWasteInput,
    printHoursInput,
    electricityRateInput,
    printerPriceInput,
    lifespanInput,
    maintenanceInput,
    failureRateInput,
    laborMinutesInput,
    laborRateInput,
    hardwareCostInput,
    packagingCostInput,
    markupSlider,
  ].forEach(input => {
    input?.addEventListener('input', updateCalculations);
  });

  etsyAdsCheckbox?.addEventListener('change', updateCalculations);

  // Share quote button
  shareQuoteBtn?.addEventListener('click', () => {
    const params = new URLSearchParams({
      printer: printerSelect.value,
      mat: materialSelect.value,
      price: spoolPriceInput.value,
      weight: printWeightInput.value,
      time: printHoursInput.value,
      power: printerWattsInput.value,
      density: materialDensityInput.value,
      markup: markupSlider.value,
    });

    const shareUrl = `${window.location.origin}${window.location.pathname}?${params.toString()}`;
    navigator.clipboard.writeText(shareUrl).then(() => {
      if (shareToast) {
        shareToast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          shareToast.classList.add('translate-y-20', 'opacity-0');
        }, 3000);
      }
    });
  });

  // Teleport Quote Modal to document.body for clean 1-page print isolation
  if (quoteInvoiceModal && quoteInvoiceModal.parentElement !== document.body) {
    document.body.appendChild(quoteInvoiceModal);
  }

  // Client PDF Quote Invoice Modal
  printQuoteBtn?.addEventListener('click', () => {
    if (invoiceDate) invoiceDate.textContent = new Date().toLocaleDateString();
    if (invoiceRef) invoiceRef.textContent = `#3DP-${Math.floor(1000 + Math.random() * 9000)}`;
    if (quoteInvoiceModal) quoteInvoiceModal.classList.remove('hidden');
  });

  closeInvoiceBtn?.addEventListener('click', () => {
    if (quoteInvoiceModal) quoteInvoiceModal.classList.add('hidden');
  });

  triggerPrintBtn?.addEventListener('click', () => {
    document.body.classList.add('printing-quote');
    window.print();
  });

  window.addEventListener('afterprint', () => {
    document.body.classList.remove('printing-quote');
  });

  window.addEventListener('beforeprint', () => {
    if (quoteInvoiceModal && !quoteInvoiceModal.classList.contains('hidden')) {
      document.body.classList.add('printing-quote');
    }
  });

  // Load URL query params if present on initial load
  function loadUrlParams() {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('printer')) printerSelect.value = urlParams.get('printer')!;
    if (urlParams.has('mat')) materialSelect.value = urlParams.get('mat')!;
    if (urlParams.has('price')) spoolPriceInput.value = urlParams.get('price')!;
    if (urlParams.has('weight')) printWeightInput.value = urlParams.get('weight')!;
    if (urlParams.has('time')) printHoursInput.value = urlParams.get('time')!;
    if (urlParams.has('power')) printerWattsInput.value = urlParams.get('power')!;
    if (urlParams.has('density')) materialDensityInput.value = urlParams.get('density')!;
    if (urlParams.has('markup')) markupSlider.value = urlParams.get('markup')!;
  }

  loadUrlParams();
  updateCalculations();
</script>
