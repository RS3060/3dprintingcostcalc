---
import printersData from '../data/printers.json';
import materialsData from '../data/materials.json';
import { getTranslations } from '../i18n/translations';
import { LOCALES } from '../i18n/locales';

export interface Props {
  initialPrinterSlug?: string;
  initialMaterialSlug?: string;
  titleOverride?: string;
  locale?: string;
}

const {
  initialPrinterSlug = 'bambu-lab-p1s',
  initialMaterialSlug = 'pla',
  titleOverride,
  locale = 'en',
} = Astro.props;

const selectedPrinter = printersData.find(p => p.slug === initialPrinterSlug) || printersData[0];
const selectedMaterial = materialsData.find(m => m.slug === initialMaterialSlug) || materialsData[0];

const t = getTranslations(locale);
const locInfo = LOCALES[locale] || LOCALES.en;
const currSym = locInfo.currency;
---

<div
  id="calculatorRoot"
  class="w-full"
  data-initial-printer={initialPrinterSlug}
  data-initial-material={initialMaterialSlug}
  data-currency={currSym}
  data-profit-label={t.calc.profit}
  data-invoice-item-name={t.calc.invoiceItemName}
  data-toast-msg={t.calc.copiedToast}
>
  <!-- Top Banner / Title if provided -->
  {titleOverride ? (
    <div class="mb-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">{titleOverride}</h2>
    </div>
  ) : (
    <h2 class="sr-only">{t.calc.totalCostTitle}</h2>
  )}

  <!-- Two Column Layout: Controls (Left) and Results / Waterfall (Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT COLUMN: Inputs & File Drop (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">

      <!-- 1. Client-Side 3D File Drag & Drop Zone -->
      <div class="bg-[#0e1628] border border-white/10 rounded-2xl p-5 shadow-xl relative overflow-hidden group">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-cyan-400">{t.calc.fileInspector}</h3>
          </div>
          <span class="text-xs font-mono text-slate-400 bg-white/5 px-2.5 py-1 rounded-full border border-white/5">
            {t.calc.clientSide}
          </span>
        </div>

        <!-- Drag Target -->
        <div
          id="dropZone"
          tabindex="0"
          role="button"
          class="border-2 border-dashed border-cyan-500/30 hover:border-cyan-400 hover:bg-cyan-500/5 rounded-xl p-6 text-center cursor-pointer transition-all focus:outline-none focus:ring-2 focus:ring-cyan-400"
        >
          <input
            type="file"
            id="fileInput"
            class="hidden"
            accept=".stl,.3mf,.gcode,.bgcode,.obj"
            aria-label={t.calc.dropText || "Upload 3D model file (.STL, .3MF, .GCODE, .OBJ)"}
          />
          <div class="flex flex-col items-center justify-center space-y-2">
            <div class="w-12 h-12 rounded-full bg-cyan-500/10 text-cyan-400 flex items-center justify-center border border-cyan-500/20 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" x2="12" y1="2" y2="15"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-slate-200">
              {t.calc.dropText}
            </p>
            <p class="text-xs text-slate-400">
              {t.calc.dropBrowse}
            </p>
          </div>
        </div>

        <!-- Parsed File Status Card (Hidden by default until file dropped) -->
        <div id="fileInfoCard" class="hidden mt-4 p-4 rounded-xl bg-cyan-950/40 border border-cyan-500/30 text-xs">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2 font-mono text-cyan-300 font-semibold">
              <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span id="parsedFileName">model.stl</span>
            </div>
            <span id="parsedFileTypeBadge" class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 text-[11px] font-mono">
              Binary STL
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-slate-300 font-mono text-[11px]">
            <div>
              <span class="text-slate-400 block">{t.calc.fileSize}</span>
              <span id="parsedFileSize" class="font-bold text-white">0 KB</span>
            </div>
            <div>
              <span class="text-slate-400 block">{t.calc.calcGrams}</span>
              <span id="parsedFilamentGrams" class="font-bold text-cyan-400">0.0g</span>
            </div>
            <div>
              <span class="text-slate-400 block">{t.calc.estPrintTime}</span>
              <span id="parsedPrintTime" class="font-bold text-white">0h 0m</span>
            </div>
            <div>
              <span class="text-slate-400 block">{t.calc.meshVolume}</span>
              <span id="parsedMeshVol" class="font-bold text-white">0 cm³</span>
            </div>
          </div>

          <!-- Slicer vs Mesh info note -->
          <p id="parsedNote" class="mt-2 text-[11px] text-cyan-300/80 italic">
            {t.calc.exactMetadata}
          </p>

          <!-- Secondary sliders if unsliced mesh (.stl / .obj / raw .3mf) -->
          <div id="meshAdjustControls" class="hidden mt-3 pt-3 border-t border-cyan-500/20 space-y-3">
            <div class="flex items-center justify-between text-[11px] text-slate-300">
              <span class="font-semibold text-cyan-300">{t.calc.slicerSliders}</span>
              <span class="text-slate-400">{t.calc.adjustProfile}</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label for="wallLoopsInput" class="block text-[11px] text-slate-400 mb-1">{t.calc.wallLoops} <span id="wallLoopsVal" class="text-cyan-400 font-bold">2</span></label>
                <input type="range" id="wallLoopsInput" min="1" max="6" value="2" class="w-full h-1.5 bg-slate-700 rounded-lg" />
              </div>
              <div>
                <label for="infillInput" class="block text-[11px] text-slate-400 mb-1">{t.calc.infillDensity} <span id="infillVal" class="text-cyan-400 font-bold">15%</span></label>
                <input type="range" id="infillInput" min="0" max="100" step="5" value="15" class="w-full h-1.5 bg-slate-700 rounded-lg" />
              </div>
              <div>
                <label for="supportSelect" class="block text-[11px] text-slate-400 mb-1">{t.calc.supports}</label>
                <select id="supportSelect" class="w-full bg-[#080c15] border border-white/10 rounded px-2 py-1 text-[11px] text-white">
                  <option value="1.0">{t.calc.supportNone}</option>
                  <option value="1.08">{t.calc.supportTree}</option>
                  <option value="1.18">{t.calc.supportHeavy}</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Hardware & Material Presets + Manual Inputs -->
      <div class="bg-[#0e1628] border border-white/10 rounded-2xl p-5 shadow-xl space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-300">{t.calc.secMachine}</h3>
          <span class="text-xs font-mono text-cyan-400">{t.calc.secMachineBadge}</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Printer Selector -->
          <div>
            <label for="printerSelect" class="block text-xs font-medium text-slate-400 mb-1">
              {t.calc.printerModel}
            </label>
            <select
              id="printerSelect"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"
            >
              <option value="custom">{t.calc.customPrinter}</option>
              {printersData.map((printer) => (
                <option value={printer.slug} selected={printer.slug === selectedPrinter.slug}>
                  {printer.brand} - {printer.model} ({printer.avgWattsPla}W)
                </option>
              ))}
            </select>
          </div>

          <!-- Printer Power (Watts) - Explicit User Insertion -->
          <div>
            <label for="printerWattsInput" class="flex justify-between text-xs font-medium text-slate-400 mb-1">
              <span>{t.calc.printerPower}</span>
              <span class="text-slate-400">{t.calc.avgDraw}</span>
            </label>
            <div class="relative">
              <input
                type="number"
                id="printerWattsInput"
                step="5"
                min="10"
                max="2500"
                value={selectedPrinter.avgWattsPla}
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
              <span class="absolute right-3 top-2 text-xs text-slate-400 font-mono">W</span>
            </div>
          </div>

          <!-- Material Selector -->
          <div>
            <label for="materialSelect" class="block text-xs font-medium text-slate-400 mb-1">
              {t.calc.filamentPreset}
            </label>
            <select
              id="materialSelect"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-cyan-500"
            >
              <option value="custom">{t.calc.customMaterial}</option>
              {materialsData.map((material) => (
                <option value={material.slug} selected={material.slug === selectedMaterial.slug}>
                  {material.name} ({material.densityGcm3} g/cm³)
                </option>
              ))}
            </select>
          </div>

          <!-- Material Density - Explicit User Insertion -->
          <div>
            <label for="materialDensityInput" class="flex justify-between text-xs font-medium text-slate-400 mb-1">
              <span>{t.calc.materialDensity}</span>
              <span class="text-slate-400">g/cm³</span>
            </label>
            <div class="relative">
              <input
                type="number"
                id="materialDensityInput"
                step="0.01"
                min="0.5"
                max="4.0"
                value={selectedMaterial.densityGcm3}
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
              <span class="absolute right-3 top-2 text-xs text-slate-400 font-mono">g/cm³</span>
            </div>
          </div>
        </div>

        <p id="printerPresetSummary" class="text-[11px] text-slate-400 font-mono">
          Watts: {selectedPrinter.avgWattsPla}W · MSRP: {currSym}{selectedPrinter.msrpUsd} · Lifespan: {selectedPrinter.defaultLifespanHours}h
        </p>
      </div>

      <!-- 3. Primary Core Inputs (Manual Sliders & Numbers) -->
      <div class="bg-[#0e1628] border border-white/10 rounded-2xl p-5 shadow-xl space-y-5">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-300">{t.calc.secJob}</h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Spool Price -->
          <div>
            <label for="spoolPriceInput" class="flex justify-between text-xs font-medium text-slate-300 mb-1">
              <span>{t.calc.spoolPrice}</span>
              <span class="text-slate-400">{currSym}19.99</span>
            </label>
            <div class="relative">
              <span class="absolute left-3 top-2.5 text-slate-400 text-sm">{currSym}</span>
              <input
                type="number"
                id="spoolPriceInput"
                step="0.01"
                min="0"
                value="19.99"
                class="w-full bg-[#162035] border border-white/10 rounded-xl pl-7 pr-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>
          </div>

          <!-- Spool Size -->
          <div>
            <label for="spoolWeightInput" class="flex justify-between text-xs font-medium text-slate-300 mb-1">
              <span>{t.calc.spoolWeight}</span>
              <span class="text-slate-400">1kg = 1000g</span>
            </label>
            <input
              type="number"
              id="spoolWeightInput"
              step="50"
              min="1"
              value="1000"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
            />
            <div class="flex gap-1.5 mt-1.5">
              <button type="button" class="spool-preset-btn text-[10px] px-2 py-0.5 rounded bg-white/5 hover:bg-cyan-500/20 text-slate-300 font-mono transition-colors" data-weight="1000">1kg</button>
              <button type="button" class="spool-preset-btn text-[10px] px-2 py-0.5 rounded bg-white/5 hover:bg-cyan-500/20 text-slate-300 font-mono transition-colors" data-weight="750">750g</button>
              <button type="button" class="spool-preset-btn text-[10px] px-2 py-0.5 rounded bg-white/5 hover:bg-cyan-500/20 text-slate-300 font-mono transition-colors" data-weight="250">250g</button>
              <button type="button" class="spool-preset-btn text-[10px] px-2 py-0.5 rounded bg-white/5 hover:bg-cyan-500/20 text-slate-300 font-mono transition-colors" data-weight="2500">2.5kg</button>
            </div>
          </div>

          <!-- Print Weight (Grams) -->
          <div>
            <label for="printWeightInput" class="flex justify-between text-xs font-medium text-slate-300 mb-1">
              <span>{t.calc.printWeight}</span>
              <span id="printWeightGramLive" class="text-cyan-400 font-mono">85g</span>
            </label>
            <input
              type="number"
              id="printWeightInput"
              step="0.1"
              min="0"
              value="85"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
            />
          </div>

          <!-- Purge / AMS Waste (Grams) -->
          <div>
            <label for="purgeWasteInput" class="flex justify-between text-xs font-medium text-slate-300 mb-1">
              <span>{t.calc.purgeWaste}</span>
              <span class="text-slate-400">AMS / Support</span>
            </label>
            <input
              type="number"
              id="purgeWasteInput"
              step="0.1"
              min="0"
              value="0"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
            />
          </div>

          <!-- Print Time (Hours) -->
          <div>
            <label for="printHoursInput" class="flex justify-between text-xs font-medium text-slate-300 mb-1">
              <span>{t.calc.printHours}</span>
              <span id="printTimeLive" class="text-cyan-400 font-mono">3.5 hrs</span>
            </label>
            <input
              type="number"
              id="printHoursInput"
              step="0.1"
              min="0"
              value="3.5"
              class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
            />
          </div>

          <!-- Electricity Rate ($/kWh) -->
          <div>
            <label for="electricityRateInput" class="flex justify-between text-xs font-medium text-slate-300 mb-1">
              <span>{t.calc.electricityRate}</span>
              <span class="text-slate-400">Avg kWh</span>
            </label>
            <div class="relative">
              <span class="absolute left-3 top-2.5 text-slate-400 text-sm">{currSym}</span>
              <input
                type="number"
                id="electricityRateInput"
                step="0.01"
                min="0"
                value="0.16"
                class="w-full bg-[#162035] border border-white/10 rounded-xl pl-7 pr-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Advanced Cost & Overhead Accordion -->
      <div class="bg-[#0e1628] border border-white/10 rounded-2xl shadow-xl overflow-hidden">
        <button
          type="button"
          id="advancedToggleBtn"
          class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-white/5 transition-colors focus:outline-none cursor-pointer"
        >
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-sm font-semibold uppercase tracking-wider text-slate-200">
              {t.calc.secAdvanced}
            </span>
          </div>
          <svg id="advancedArrow" class="w-5 h-5 text-slate-400 transform transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <div id="advancedContent" class="hidden px-5 pb-5 pt-2 border-t border-white/5 space-y-4">
          <p class="text-xs text-slate-400">
            {t.calc.advancedDesc}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Printer Purchase Price -->
            <div>
              <label for="printerPriceInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.printerPrice}</label>
              <input
                type="number"
                id="printerPriceInput"
                step="10"
                min="0"
                value={selectedPrinter.msrpUsd}
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>

            <!-- Lifespan Hours -->
            <div>
              <label for="lifespanInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.lifespan}</label>
              <input
                type="number"
                id="lifespanInput"
                step="100"
                min="500"
                value={selectedPrinter.defaultLifespanHours}
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>

            <!-- Hourly Maintenance / Nozzle Reserve -->
            <div>
              <label for="maintenanceInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.maintenance}</label>
              <input
                type="number"
                id="maintenanceInput"
                step="0.01"
                min="0"
                value={selectedPrinter.hourlyMaintenanceUsd}
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>

            <!-- Failure Rate % -->
            <div>
              <label for="failureRateInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.failureRate}</label>
              <input
                type="number"
                id="failureRateInput"
                step="1"
                min="0"
                max="50"
                value="5"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>

            <!-- Post-Processing Labor Minutes -->
            <div>
              <label for="laborMinutesInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.laborMinutes}</label>
              <input
                type="number"
                id="laborMinutesInput"
                step="1"
                min="0"
                value="10"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>

            <!-- Labor Rate $/hr -->
            <div>
              <label for="laborRateInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.laborRate}</label>
              <input
                type="number"
                id="laborRateInput"
                step="1"
                min="0"
                value="20"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>

            <!-- Hardware & Fasteners -->
            <div>
              <label for="hardwareCostInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.hardwareCost}</label>
              <input
                type="number"
                id="hardwareCostInput"
                step="0.1"
                min="0"
                value="0.50"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>

            <!-- Packaging Box -->
            <div>
              <label for="packagingCostInput" class="block text-xs font-medium text-slate-300 mb-1">{t.calc.packagingCost}</label>
              <input
                type="number"
                id="packagingCostInput"
                step="0.1"
                min="0"
                value="1.25"
                class="w-full bg-[#162035] border border-white/10 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Results Card, Waterfall & Seller Margins (5 Cols) -->
    <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-20">

      <!-- Primary Results Card -->
      <div class="bg-gradient-to-b from-[#131d33] to-[#0c1424] border border-cyan-500/30 rounded-2xl p-6 shadow-2xl glow-cyan relative overflow-hidden">
        <!-- Top accent beam -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-400 via-blue-500 to-emerald-400"></div>

        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono uppercase tracking-wider text-cyan-300 font-semibold">{t.calc.totalCostTitle}</span>
          <span class="text-xs font-mono text-slate-400" id="costPerGramBadge">{currSym}0.0200/g</span>
        </div>

        <!-- Big Cost Display -->
        <div class="flex items-baseline gap-2 mb-4">
          <span class="text-4xl sm:text-5xl font-black tracking-tight text-white font-mono" id="totalLandedCostDisplay">
            {currSym}7.85
          </span>
          <span class="text-sm font-medium text-slate-400">{locInfo.currencyCode}</span>
        </div>

        <!-- Cost Breakdown Table -->
        <div class="border-t border-white/10 pt-3 space-y-2 text-xs font-mono">
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{t.calc.filamentMat}</span>
            <span id="costMaterialDisplay" class="font-bold text-white">{currSym}1.70</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{t.calc.electricityKwh}</span>
            <span id="costElectricityDisplay" class="font-bold text-white">{currSym}0.07</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{t.calc.machineWear}</span>
            <span id="costMachineDisplay" class="font-bold text-white">{currSym}0.94</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{t.calc.failureRisk}</span>
            <span id="costFailureDisplay" class="font-bold text-white">{currSym}0.14</span>
          </div>
          <div class="flex justify-between text-slate-300">
            <span class="text-slate-400">{t.calc.laborInserts}</span>
