            <div id="barElec" class="bg-amber-500 h-full" style="width: 5%" title="Electricity"></div>
            <div id="barMachine" class="bg-blue-500 h-full" style="width: 15%" title="Machine Wear"></div>
            <div id="barLabor" class="bg-emerald-500 h-full" style="width: 45%" title="Labor"></div>
            <div id="barOther" class="bg-violet-500 h-full" style="width: 10%" title="Packaging & Other"></div>
          </div>
          <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-[10px] text-slate-400 font-mono">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-cyan-500"></span>Mat</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span>Power</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-500"></span>Machine</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>Labor</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-violet-500"></span>Pack</span>
          </div>
        </div>
      </div>

      <!-- Commercial Marketplace Waterfall Card -->
      <div class="bg-[#0e1628] border border-white/10 rounded-2xl p-5 shadow-xl space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-300">{t.calc.commercialPricing}</h3>
          <span class="text-xs font-mono text-cyan-400" id="multiplierLabel">{t.calc.markupMultiplier}</span>
        </div>

        <!-- Markup Slider -->
        <div>
          <label for="markupSlider" class="flex justify-between text-xs text-slate-400 mb-1">
            <span>{t.calc.markupMultiplier}:</span>
            <span id="targetMarginLabel" class="text-emerald-400 font-mono">{t.calc.targetMargin}</span>
          </label>
          <input
            type="range"
            id="markupSlider"
            min="1.2"
            max="5.0"
            step="0.1"
            value="2.5"
