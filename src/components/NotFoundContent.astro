---
import Layout from '../layouts/Layout.astro';
import { getLocalizedPath } from '../i18n/locales';
import { getTranslations } from '../i18n/translations';
import { getNotFoundTranslation, NOT_FOUND_TRANSLATIONS, SITE_UI_TRANSLATIONS } from '../i18n/translations/404';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const currentLocale = locale;
const t = getTranslations(currentLocale);
const n404 = getNotFoundTranslation(currentLocale);
---

<Layout
  title={n404.metaTitle}
  description={n404.metaDescription}
  noindex={true}
  locale={currentLocale}
  breadcrumbs={[
    { name: t.nav.jobCost, item: getLocalizedPath('/', currentLocale) },
    { name: '404', item: getLocalizedPath('/404/', currentLocale) }
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-center space-y-10" id="notFoundRoot">
    
    <!-- 404 Visual Badge & Graphic -->
    <div class="relative inline-block">
      <!-- Glow effect -->
      <div class="absolute -inset-4 bg-cyan-500/20 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative inline-flex flex-col items-center">
        <!-- Technical 3D Printing Error Icon -->
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-[#0e1628] border-2 border-cyan-500/40 flex items-center justify-center text-cyan-400 shadow-2xl glow-cyan mb-4">
          <svg class="w-12 h-12 sm:w-14 sm:h-14 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>

        <div id="badgeStatus404" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-cyan-950/60 text-cyan-300 border border-cyan-800/50 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping" aria-hidden="true"></span>
          <span id="txt404Badge">{n404.badge}</span>
        </div>
      </div>
    </div>

    <!-- Main Title & Description -->
    <div class="space-y-4 max-w-2xl mx-auto">
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white">
        <span id="txt404TitlePrimary">{n404.titlePrimary}</span> <span id="txt404TitleGradient" class="bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">{n404.titleGradient}</span>
      </h1>
      <p id="txt404Desc" class="text-sm sm:text-base text-slate-300 leading-relaxed">
        {n404.description}
      </p>
    </div>

    <!-- Diagnostic Terminal Box -->
    <div class="max-w-lg mx-auto text-left bg-[#0c1220] border border-white/10 rounded-2xl p-4 sm:p-5 shadow-2xl font-mono text-xs text-slate-300 space-y-2">
      <div class="flex items-center justify-between pb-2 border-b border-white/5 text-[11px] text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="ml-2" id="txt404LogFile">{n404.logFile}</span>
        </span>
        <span class="text-rose-400 font-bold">ERROR_E404</span>
      </div>
      <div class="space-y-1 text-slate-400 text-[11px] sm:text-xs">
        <p><span class="text-cyan-400">&gt;</span> G28 X0 Y0 Z0 <span class="text-slate-400" id="txt404LogHoming">{n404.logHoming}</span></p>
        <p><span class="text-cyan-400">&gt;</span> M104 S0 ; <span id="txt404LogCooldown">{n404.logCooldown}</span></p>
        <p><span class="text-cyan-400">&gt;</span> M140 S0 ; <span id="txt404LogBed">{n404.logBedShutdown}</span></p>
        <p class="text-rose-400 font-semibold"><span class="text-rose-500">&gt;</span> <span id="txt404LogException">{n404.logException}</span></p>
        <p class="text-cyan-300">&gt; <span id="txt404LogReroute">{n404.logReroute}</span></p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <a
        id="btn404JobCost"
        href={getLocalizedPath('/', currentLocale)}
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-sm tracking-wide shadow-lg shadow-cyan-900/40 transition-all hover:scale-105 inline-flex items-center justify-center gap-2"
        style="color: #ffffff !important;"
      >
        <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: #ffffff !important;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span id="txt404BtnJobCost" class="text-white" style="color: #ffffff !important;">{n404.btnJobCost}</span>
      </a>

      <a
        id="btn404Tco"
        href={getLocalizedPath('/3d-printer-cost-calculator/', currentLocale)}
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#162035] hover:bg-[#1e2c48] text-slate-200 font-semibold text-sm border border-white/10 transition-colors inline-flex items-center justify-center gap-2"
      >
        <span id="txt404BtnTco">{n404.btnTco}</span>
        <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </div>

    <!-- Quick Navigation Directory -->
    <div class="pt-10 border-t border-white/10 text-left">
      <h2 id="txt404CalcTitle" class="text-lg font-bold text-white mb-4 text-center sm:text-left">
        {n404.calcDirectoryTitle}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- 1. Job Cost -->
        <a id="navCardJobCost" href={getLocalizedPath('/', currentLocale)} class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-cyan-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span id="cardTitleJobCost" class="card-title">{t.nav.jobCost}</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">.STL, .3MF, .GCODE</p>
        </a>

        <!-- 2. Printer TCO -->
        <a id="navCardPrinterTco" href={getLocalizedPath('/3d-printer-cost-calculator/', currentLocale)} class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-blue-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-blue-400">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span id="cardTitlePrinterTco" class="card-title">{t.nav.printerTco}</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">TCO &amp; Power</p>
        </a>

        <!-- 3. Filament Cost -->
        <a id="navCardFilament" href={getLocalizedPath('/filament-cost-calculator/', currentLocale)} class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-emerald-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span id="cardTitleFilament" class="card-title">{t.nav.filamentLength}</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Weight ⇄ Length</p>
        </a>

        <!-- 4. Spool Tare -->
        <a id="navCardSpool" href={getLocalizedPath('/spool-remaining-calculator/', currentLocale)} class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-cyan-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-cyan-400">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span id="cardTitleSpool" class="card-title">{t.nav.spoolTare}</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Tare DB</p>
        </a>

        <!-- 5. AMS Waste -->
        <a id="navCardAms" href={getLocalizedPath('/multicolor-ams-waste-calculator/', currentLocale)} class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-purple-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-purple-400">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            <span id="cardTitleAms" class="card-title">{t.nav.amsWaste}</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Multi-Color Purge</p>
        </a>

        <!-- 6. Resin SLA -->
        <a id="navCardResin" href={getLocalizedPath('/resin-3d-print-cost-calculator/', currentLocale)} class="p-4 rounded-xl bg-[#0e1628] border border-white/10 hover:border-amber-500/40 transition-all group block">
          <div class="flex items-center gap-2 font-bold text-white text-sm group-hover:text-amber-400">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span id="cardTitleResin" class="card-title">{t.nav.resinSla}</span>
          </div>
          <p class="text-xs text-slate-400 mt-1">SLA / MSLA</p>
        </a>
      </div>
    </div>

  </div>
</Layout>

<!-- Client-side dynamic localization for Cloudflare Worker 404 fallback -->
<script is:inline define:vars={{ notFoundTranslations: NOT_FOUND_TRANSLATIONS, siteUiTranslations: SITE_UI_TRANSLATIONS }}>
  (function() {
    try {
      // 1. Detect requested locale from actual window pathname (e.g. "/ja/zxcvbz" -> "ja")
      var path = window.location.pathname || '';
      var segments = path.split('/').filter(Boolean);
      var validLocales = ['en', 'zh', 'ja', 'ko', 'fr', 'es', 'ru', 'de', 'pt', 'it'];
      var detectedLocale = 'en';

      if (segments.length > 0 && validLocales.indexOf(segments[0]) !== -1) {
        detectedLocale = segments[0];
      }

      // If user is already on the matching server-rendered page or default english, skip
      if (detectedLocale === 'en' || !notFoundTranslations[detectedLocale]) {
        return;
      }

      var trans = notFoundTranslations[detectedLocale];
      var ui = siteUiTranslations[detectedLocale] || {};
      var navUi = ui.nav || {};
      var footerUi = ui.footer || {};

      // 2. Update Document Meta Title
      if (trans.metaTitle) {
        document.title = trans.metaTitle;
      }

      // 3. Update DOM elements of 404 Hero & Terminal
      var badge = document.getElementById('txt404Badge');
      if (badge && trans.badge) badge.textContent = trans.badge;

      var titlePrimary = document.getElementById('txt404TitlePrimary');
      if (titlePrimary && trans.titlePrimary) titlePrimary.textContent = trans.titlePrimary;

      var titleGradient = document.getElementById('txt404TitleGradient');
      if (titleGradient && trans.titleGradient) titleGradient.textContent = trans.titleGradient;

      var desc = document.getElementById('txt404Desc');
      if (desc && trans.description) desc.textContent = trans.description;

      var logHoming = document.getElementById('txt404LogHoming');
      if (logHoming && trans.logHoming) logHoming.textContent = trans.logHoming;

      var logCooldown = document.getElementById('txt404LogCooldown');
      if (logCooldown && trans.logCooldown) logCooldown.textContent = trans.logCooldown;

      var logBed = document.getElementById('txt404LogBed');
      if (logBed && trans.logBedShutdown) logBed.textContent = trans.logBedShutdown;

      var logException = document.getElementById('txt404LogException');
      if (logException && trans.logException) logException.textContent = trans.logException;

      var logReroute = document.getElementById('txt404LogReroute');
      if (logReroute && trans.logReroute) logReroute.textContent = trans.logReroute;

      var btnJob = document.getElementById('txt404BtnJobCost');
      if (btnJob && trans.btnJobCost) btnJob.textContent = trans.btnJobCost;

      var btnTco = document.getElementById('txt404BtnTco');
      if (btnTco && trans.btnTco) btnTco.textContent = trans.btnTco;

      var calcTitle = document.getElementById('txt404CalcTitle');
      if (calcTitle && trans.calcDirectoryTitle) calcTitle.textContent = trans.calcDirectoryTitle;

      // 4. Update the 6 Calculator Directory Boxes Text
      if (navUi.jobCost) {
        var el = document.getElementById('cardTitleJobCost');
        if (el) el.textContent = navUi.jobCost;
      }
      if (navUi.printerTco) {
        var el = document.getElementById('cardTitlePrinterTco');
        if (el) el.textContent = navUi.printerTco;
      }
      if (navUi.filamentLength) {
        var el = document.getElementById('cardTitleFilament');
        if (el) el.textContent = navUi.filamentLength;
      }
      if (navUi.spoolTare) {
        var el = document.getElementById('cardTitleSpool');
        if (el) el.textContent = navUi.spoolTare;
      }
      if (navUi.amsWaste) {
        var el = document.getElementById('cardTitleAms');
        if (el) el.textContent = navUi.amsWaste;
      }
      if (navUi.resinSla) {
        var el = document.getElementById('cardTitleResin');
        if (el) el.textContent = navUi.resinSla;
      }

      // 5. Update Navbar & Mobile Drawer & Footer Links text
      document.querySelectorAll('[data-nav]').forEach(function(el) {
        var key = el.getAttribute('data-nav');
        if (navUi[key]) {
          el.textContent = navUi[key];
        }
      });

      // 6. Update Footer Headings and Copy
      if (footerUi.aboutDesc) {
        var el = document.getElementById('footerAboutDesc');
        if (el) el.textContent = footerUi.aboutDesc;
      }
      if (footerUi.clientSideBadge) {
        var el = document.getElementById('footerClientBadge');
        if (el) el.textContent = footerUi.clientSideBadge;
      }
      if (footerUi.calculatorsCol) {
        var el = document.getElementById('footerColCalculators');
        if (el) el.textContent = footerUi.calculatorsCol;
      }
      if (footerUi.machineProfilesCol) {
        var el = document.getElementById('footerColProfiles');
        if (el) el.textContent = footerUi.machineProfilesCol;
      }
      if (footerUi.materialsCol) {
        var el = document.getElementById('footerColMaterials');
        if (el) el.textContent = footerUi.materialsCol;
      }
      if (footerUi.copyrightNotice) {
        var el = document.getElementById('footerCopyright');
        if (el) el.textContent = footerUi.copyrightNotice;
      }
      if (footerUi.builtFor) {
        var el = document.getElementById('footerBuiltFor');
        if (el) el.textContent = footerUi.builtFor;
      }

      // 7. Update All Link Hrefs to point to the detected locale
      function localizeHref(el, canonicalPath) {
        if (!el) return;
        var localized = '/' + detectedLocale + canonicalPath;
        el.setAttribute('href', localized);
      }

      localizeHref(document.getElementById('btn404JobCost'), '/');
      localizeHref(document.getElementById('btn404Tco'), '/3d-printer-cost-calculator/');
      localizeHref(document.getElementById('navCardJobCost'), '/');
      localizeHref(document.getElementById('navCardPrinterTco'), '/3d-printer-cost-calculator/');
      localizeHref(document.getElementById('navCardFilament'), '/filament-cost-calculator/');
      localizeHref(document.getElementById('navCardSpool'), '/spool-remaining-calculator/');
      localizeHref(document.getElementById('navCardAms'), '/multicolor-ams-waste-calculator/');
      localizeHref(document.getElementById('navCardResin'), '/resin-3d-print-cost-calculator/');

      // Localize header & footer hrefs with data-nav
      var pathMap = {
        jobCost: '/',
        printerTco: '/3d-printer-cost-calculator/',
        filamentLength: '/filament-cost-calculator/',
        spoolTare: '/spool-remaining-calculator/',
        amsWaste: '/multicolor-ams-waste-calculator/',
        resinSla: '/resin-3d-print-cost-calculator/'
      };
      document.querySelectorAll('a[data-nav]').forEach(function(a) {
        var k = a.getAttribute('data-nav');
        if (pathMap[k]) {
          localizeHref(a, pathMap[k]);
        }
      });

      // 8. Update HTML lang tag
      document.documentElement.lang = detectedLocale;

      // 9. Update Header Language Selector trigger display
      var langTriggerSpan = document.querySelector('#langDropdownTrigger span');
      if (langTriggerSpan) {
        var displayNames = {
          es: 'ESPAÑOL',
          zh: '中文',
          ja: '日本語',
          ko: '한국어',
          fr: 'FRANÇAIS',
          de: 'DEUTSCH',
          pt: 'PORTUGUÊS',
          it: 'ITALIANO',
          ru: 'РУССКИЙ',
          en: 'ENGLISH'
        };
        if (displayNames[detectedLocale]) {
          langTriggerSpan.textContent = displayNames[detectedLocale];
        }
      }
    } catch (e) {
      console.error('404 localization error:', e);
    }
  })();
</script>
